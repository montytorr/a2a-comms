#!/bin/bash
# Pre-push doc-sync check.
#
# Warns when code is pushed without the documentation CONTRIBUTING requires.
# Set A2A_STRICT_DOCS=1 to turn warnings into a hard block.
#
# Install with: npm run hooks:install
#
# This lives in ops/hooks/ and is version controlled. It used to live only in
# .git/hooks/, uncommitted, with CONTRIBUTING telling people to "copy it from
# the repo wiki" — which meant a fresh clone had no enforcement at all, and doc
# drift went unnoticed until somebody happened to read both surfaces.

remote="$1"
url="$2"

z40=0000000000000000000000000000000000000000
strict="${A2A_STRICT_DOCS:-0}"

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$z40" ] && continue          # deleting a ref

    if [ "$remote_sha" = "$z40" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    files=$(git diff --name-only "$range" 2>/dev/null)
    [ -z "$files" ] && continue

    has_code=false      # API, libs, migrations
    has_reactor=false   # the reference reactor
    has_cli=false       # the python CLI
    has_ops=false       # host scripts that run outside the app

    has_changelog=false
    has_docs=false
    has_skill=false
    has_reactor_doc=false

    # Markdown surfaces whose dashboard twin must move with them. Changing one
    # without the other is how a dashboard reader ends up with different
    # guidance from a repo reader.
    md_agent=false;  tsx_agent=false
    md_human=false;  tsx_human=false

    while IFS= read -r file; do
        case "$file" in
            src/app/api/*|src/lib/*|migrations/*) has_code=true ;;
        esac
        case "$file" in
            reactor/a2a_reactor/*)            has_reactor=true ;;
            reactor/README.md)                has_reactor_doc=true ;;
            skill/scripts/a2a)                has_cli=true ;;
            ops/bin/*)                        has_ops=true ;;
            CHANGELOG.md)                     has_changelog=true ;;
            skill/SKILL.md)                   has_skill=true ;;
            ONBOARDING-AGENT.md)              md_agent=true ;;
            ONBOARDING-HUMAN.md)              md_human=true ;;
        esac
        case "$file" in
            'src/app/(dashboard)/onboarding/agent/'*) tsx_agent=true ;;
            'src/app/(dashboard)/onboarding/human/'*) tsx_human=true ;;
        esac
        case "$file" in
            README.md|AGENTS.md|ONBOARDING-*.md|docs/*|'src/app/(dashboard)/security/'*|'src/app/(dashboard)/api-docs/'*|'src/app/(dashboard)/onboarding/'*)
                has_docs=true ;;
        esac
    done <<< "$files"

    missing=""

    if [ "$has_code" = true ]; then
        [ "$has_docs" = false ] && missing="$missing  - no docs updated (README, AGENTS.md, ONBOARDING, docs/, dashboard pages)\n"
    fi

    # CHANGELOG.md is deliberately not checked. scripts/ci-deploy.sh writes it
    # from the commit messages of every non-bump commit in the release, so a
    # hand-written entry would be a second one for the same change. Asking for
    # it here fired on every push that touched code, which is how a warning
    # stops being read. What the author owes is a commit message worth
    # rendering, not a duplicate entry.

    # The CLI is the agent-facing surface; SKILL.md is how an agent learns it.
    # The old hook tracked this and then never checked it.
    if [ "$has_cli" = true ] && [ "$has_skill" = false ]; then
        missing="$missing  - skill/scripts/a2a changed but skill/SKILL.md did not\n"
    fi

    if [ "$has_reactor" = true ] && [ "$has_reactor_doc" = false ]; then
        missing="$missing  - reactor/a2a_reactor/ changed but reactor/README.md did not\n"
    fi

    if [ "$has_ops" = true ] && [ "$has_docs" = false ]; then
        missing="$missing  - ops/bin/ changed but no docs updated\n"
    fi

    # Mirror pairs.
    if [ "$md_agent" = true ] && [ "$tsx_agent" = false ]; then
        missing="$missing  - ONBOARDING-AGENT.md changed but its dashboard page did not\n"
    fi
    if [ "$tsx_agent" = true ] && [ "$md_agent" = false ]; then
        missing="$missing  - the agent onboarding page changed but ONBOARDING-AGENT.md did not\n"
    fi
    if [ "$md_human" = true ] && [ "$tsx_human" = false ]; then
        missing="$missing  - ONBOARDING-HUMAN.md changed but its dashboard page did not\n"
    fi
    if [ "$tsx_human" = true ] && [ "$md_human" = false ]; then
        missing="$missing  - the human onboarding page changed but ONBOARDING-HUMAN.md did not\n"
    fi

    if [ -n "$missing" ]; then
        echo ""
        echo "DOC SYNC CHECK"
        echo "--------------"
        echo -e "$missing"
        if [ "$strict" = "1" ]; then
            echo "BLOCKED (A2A_STRICT_DOCS=1). Update the docs, or unset it to push with a warning."
            exit 1
        fi
        echo "This is a warning, not a block. Set A2A_STRICT_DOCS=1 to enforce."
        echo ""
    fi
done

exit 0
