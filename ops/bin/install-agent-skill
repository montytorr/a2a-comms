#!/bin/bash
#
# Sync the repo's skill into an agent runtime's skills directory.
#
# CONTRIBUTING used to describe the runtime copy as "symlinked ... stays in
# sync". It was not a symlink, it was a manual copy, and it had drifted: the
# runtime SKILL.md and CLI were a day behind main, so an agent reading its skill
# was told to write `--description '...\n...'` at the same time as the API
# started refusing exactly that.
#
# Symlinking the directory to fix it would be worse. The runtime directory holds
# scripts that exist ONLY there and are deliberately not in this repo:
#
#   scripts/holloway-reactor           the private reactor (reactor/ is the public one)
#   scripts/holloway-expire-sweep
#   scripts/holloway-webhook-receiver
#   scripts/holloway-webhook-recovery
#   tests/
#
# (named a2a-* before the rename to Holloway; see below.)
#
# A directory symlink would hide all of them behind this repo's smaller skill/.
# So this copies only the files the repo actually owns and never removes
# anything, which is why it is a script and not a --delete rsync.
#
# The rename. The skill used to install to ~/clawd/skills/a2a-comms. When the
# target is .../holloway and a real .../a2a-comms directory sits beside it with
# no holloway yet, that existing install is updated IN PLACE and keeps its
# directory name. It is not moved: live things call into it by path — a
# container bind-mounts scripts/a2a-webhook-receiver, cron execs
# scripts/a2a-reactor — and a move would break the mount on the container's
# next restart. It is not copied either, and no symlink is added: the runtime
# loads every directory in skills/, so a second one loads the skill twice. A
# fresh machine installs to .../holloway. Inside the install, each private
# scripts/a2a-<name> becomes scripts/holloway-<name> with an a2a-<name> symlink
# left in its place, so anything that calls the old path still works.
# scripts/a2a is a symlink to scripts/holloway, as in this repo.
# Every step is skipped when already done, so re-running is safe.
#
# Usage:
#   ops/bin/install-agent-skill [target_dir]        # default ~/clawd/skills/holloway
#   ops/bin/install-agent-skill --check [target]    # report drift, change nothing
#
set -e

CHECK=0
if [ "$1" = "--check" ]; then
  CHECK=1
  shift
fi

TARGET="${1:-$HOME/clawd/skills/holloway}"
SOURCE="$(cd "$(dirname "$0")/../../skill" && pwd)"

# Only these. Anything else in TARGET belongs to the runtime, not to this repo.
OWNED="SKILL.md README.md scripts/holloway"
# Owned symlinks, as "link:points-to". The CLI's name before the rename.
OWNED_LINKS="scripts/a2a:holloway"

drift=0
warned=0

if [ "$(basename "$TARGET")" = "holloway" ]; then
  LEGACY="$(dirname "$TARGET")/a2a-comms"
  if [ -L "$LEGACY" ]; then
    echo "install-agent-skill: $LEGACY is a symlink; remove it or the runtime loads the skill twice" >&2
    warned=1
  elif [ -d "$LEGACY" ] && [ ! -e "$TARGET" ]; then
    echo "install-agent-skill: updating the existing install at $LEGACY in place"
    TARGET="$LEGACY"
  elif [ -d "$LEGACY" ]; then
    echo "install-agent-skill: both $LEGACY and $TARGET exist; the runtime loads the skill twice." >&2
    echo "  Move anything only $LEGACY holds into $TARGET, then remove $LEGACY." >&2
    warned=1
  fi
fi

if [ ! -d "$TARGET" ]; then
  if [ "$CHECK" = "1" ] && [ "$drift" = "1" ]; then
    echo "run ops/bin/install-agent-skill to sync" >&2
    exit 1
  fi
  echo "install-agent-skill: $TARGET does not exist" >&2
  exit 1
fi

for file in $OWNED; do
  src="$SOURCE/$file"
  dst="$TARGET/$file"
  [ -f "$src" ] || continue

  if [ -f "$dst" ] && [ ! -L "$dst" ] && cmp -s "$src" "$dst"; then
    continue
  fi

  drift=1
  if [ "$CHECK" = "1" ]; then
    echo "drift: $file"
  else
    mkdir -p "$(dirname "$dst")"
    rm -f "$dst"
    cp "$src" "$dst"
    [ -x "$src" ] && chmod +x "$dst"
    echo "updated: $file"
  fi
done

for entry in $OWNED_LINKS; do
  link="${entry%%:*}"
  dest="${entry#*:}"
  dst="$TARGET/$link"
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$dest" ]; then
    continue
  fi
  drift=1
  if [ "$CHECK" = "1" ]; then
    echo "drift: $link (should link to $dest)"
  else
    rm -f "$dst"
    ln -s "$dest" "$dst"
    echo "linked: $link -> $dest"
  fi
done

# The runtime-only helpers: scripts/a2a-<name> -> scripts/holloway-<name>.
for old in "$TARGET"/scripts/a2a-*; do
  [ -f "$old" ] && [ ! -L "$old" ] || continue
  name="$(basename "$old")"
  new="holloway-${name#a2a-}"
  if [ -e "$TARGET/scripts/$new" ]; then
    echo "install-agent-skill: scripts/$name and scripts/$new both exist; leaving both" >&2
    warned=1
    continue
  fi
  drift=1
  if [ "$CHECK" = "1" ]; then
    echo "drift: scripts/$name should become scripts/$new"
  else
    mv "$old" "$TARGET/scripts/$new"
    ln -s "$new" "$old"
    echo "renamed: scripts/$name -> scripts/$new (old name kept as a symlink)"
  fi
done

if [ "$drift" = "0" ]; then
  echo "agent skill is in sync with $SOURCE"
elif [ "$CHECK" = "1" ]; then
  echo "run ops/bin/install-agent-skill to sync" >&2
  exit 1
fi

[ "$warned" = "0" ] || exit 1
