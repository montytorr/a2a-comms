        "reject": cmd_reject,
        "cancel": cmd_cancel,
        "close": cmd_close,
        "messages": cmd_messages,
        "message": cmd_message,
        "send": cmd_send,
        "receipt": cmd_receipt,
        "approve-completion": cmd_approve_completion,
        # Operator channel
        "notes": cmd_notes,
        "note-ack": cmd_note_ack,
        "ask": cmd_ask,
        "questions": cmd_questions,
        "pending": cmd_pending,
        "inbox": cmd_inbox,
        "webhook": cmd_webhook,
        "rotate-keys": cmd_rotate_keys,
        # Project management
        "projects": cmd_projects,
        "project": cmd_project,
        "project-create": cmd_project_create,
        "project-update": cmd_project_update,
        "project-members": cmd_project_members,
        "project-invitations": cmd_project_invitations,
        "project-invite": cmd_project_invite,
        "project-observers": cmd_project_observers,
        "project-observer-add": cmd_project_observer_add,
        "project-observer-update": cmd_project_observer_update,
        "project-observer-remove": cmd_project_observer_remove,
        "project-invitation-accept": cmd_project_invitation_accept,
        "project-invitation-decline": cmd_project_invitation_decline,
        "project-invitation-cancel": cmd_project_invitation_cancel,
        "invitation-sweep": cmd_invitation_sweep,
        # Sprints
        "sprints": cmd_sprints,
        "sprint": cmd_sprint,
        "sprint-create": cmd_sprint_create,
        "sprint-update": cmd_sprint_update,
        # Tasks
        "tasks": cmd_tasks,
        "task": cmd_task,
        "task-create": cmd_task_create,
        "task-update": cmd_task_update,
        "blocker-follow-up": cmd_blocker_follow_up,
        "blocker-escalate": cmd_blocker_escalate,
        "task-runs": cmd_task_runs,
        "task-run-start": cmd_task_run_start,
        "task-run": cmd_task_run,
        "task-run-update": cmd_task_run_update,
        "checkpoints": cmd_checkpoints,
        "checkpoint": cmd_checkpoint,
        "task-attach": cmd_task_attach,
        "contract-attach": cmd_contract_attach,
        # Dependencies
        "deps": cmd_deps,
        "dep-add": cmd_dep_add,
        "dep-remove": cmd_dep_remove,
        # Task-Contract links
        "task-contracts": cmd_task_contracts,
