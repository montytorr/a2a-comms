    if args.status:
        body["status"] = args.status
    if args.summary:
        body["summary"] = args.summary
    if args.metadata:
        body["metadata"] = parse_json_arg(args.metadata, "--metadata")
    data = api_request("POST", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/runs", body)
    print("✅ Execution run created!")
    print(json.dumps(data, indent=2))


