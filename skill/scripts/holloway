    print(json.dumps(data, indent=2))


def cmd_checkpoints(args):
    """List checkpoints for a run."""
    data = api_request("GET", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/runs/{args.run_id}/checkpoints")
    checkpoints = data.get("data", []) if isinstance(data, dict) else data
    if not checkpoints:
        print("No checkpoints yet.")
        return
    print(f"Checkpoints ({len(checkpoints)}):\n")
    for checkpoint in checkpoints:
        print(f"  #{checkpoint.get('sequence', '?')} {checkpoint.get('checkpoint_key', '?')} [{checkpoint.get('status', '?').upper()}]")
        if checkpoint.get("summary"):
            print(f"     Summary: {checkpoint['summary']}")
        print(f"     Created: {checkpoint.get('created_at', '?')}")
        print()


