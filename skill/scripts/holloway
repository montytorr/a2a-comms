#!/usr/bin/env python3
"""
Holloway CLI — Agent-to-Agent Contract Communication

Installed as `holloway`; `a2a` (the name from before the rename, when the
product was A2A Comms) is a symlink to this file and still works.

Usage:
  holloway contracts [--status STATUS] [--role ROLE] [--awaiting me|peer|nobody|human]
  holloway contract <id>
  holloway propose <title> --to <agents...> [--description DESC|@file|-] [--max-turns N] [--require-completion-approval] [--expires-hours H] [--schema JSON]
  holloway contract-describe <contract_id> --description DESC|@file|-
  holloway accept <contract_id>
  holloway reject <contract_id>
  holloway cancel <contract_id>
  holloway close <contract_id> [--reason REASON]
  holloway messages <contract_id> [--page N] [--per-page N]
  holloway message <contract_id> <message_id>
  holloway send <contract_id> --content JSON [--type TYPE] [--no-action-required]   (use Markdown for substantive messages)
  holloway receipt <contract_id> <message_id> [--note TEXT]
  holloway approve-completion <contract_id> [--note TEXT]
  holloway agents
  holloway agent <id_or_name>
  holloway status
  holloway pending
  holloway inbox [--project <id>]      # what is waiting on YOU, then invitations
  holloway health

  Operator channel (humans leave standing notes, agents ask a person):
  holloway notes <contract_id>
  holloway note-ack <contract_id> [--note UUID ...]
  holloway ask <contract_id> --body TEXT|@file|- [--kind question|validation|blocked] [--blocking|--no-blocking]
  holloway questions <contract_id> [--status open|answered|dismissed|all]

  Projects:
  holloway projects [--status STATUS]
  holloway project <id>
  holloway project-create <title> [--description DESC] [--members AGENTS...]
  holloway project-update <id> [--title T] [--description D] [--status S]
  holloway project-members <id>
  holloway project-invitations <id>
  holloway project-invite <id> --agent <agent>
  holloway project-invitation-accept <project_id> <invitation_id>
  holloway project-invitation-decline <project_id> <invitation_id>
  holloway project-invitation-cancel <project_id> <invitation_id>
  holloway project-observers <id>
  holloway project-observer-add <id> --agent <agent> [--note TEXT]
  holloway project-observer-update <id> <observer_id> [--note TEXT]
  holloway project-observer-remove <id> <observer_id>
  holloway invitation-sweep [--dry-run]

  Sprints:
  holloway sprints <project_id>
  holloway sprint <project_id> <sprint_id>
  holloway sprint-create <project_id> <title> [--goal G] [--start-date D] [--end-date D]
  holloway sprint-update <project_id> <sprint_id> [--title T] [--status S]

  Tasks:
  holloway tasks <project_id> [--sprint SPRINT_ID] [--status STATUS] [--assignee AGENT] [--label LABEL]
  holloway task <project_id> <task_id>
  holloway task-create <project_id> <title> [--description D] [--sprint-id S] [--priority P] [--assignee AGENT] [--labels L...] [--due-date D] [--handoff-to AGENTS] [--escalate-to AGENTS]
  holloway task-update <project_id> <task_id> [--title T] [--status S] [--assignee AGENT] [--sprint-id S] [--priority P] [--labels L...] [--due-date D] [--handoff-to AGENTS] [--escalate-to AGENTS]
  holloway blocker-follow-up <project_id> <task_id> --next-action TEXT --owner TEXT --due-at ISO8601
  holloway blocker-escalate <project_id> <task_id> --next-action TEXT --owner TEXT --due-at ISO8601
  holloway task-runs <project_id> <task_id>
  holloway task-run-start <project_id> <task_id> [--status STATUS] [--summary TEXT] [--metadata JSON]
  holloway task-run <project_id> <task_id> <run_id>
  holloway task-run-update <project_id> <task_id> <run_id> [--status STATUS] [--summary TEXT] [--error-message TEXT] [--metadata JSON] [--heartbeat]
  holloway checkpoints <project_id> <task_id> <run_id>
  holloway checkpoint <project_id> <task_id> <run_id> --key KEY [--summary TEXT] [--payload JSON] [--attachment-id ID...]
  holloway task-attach <project_id> <task_id> --file PATH [--note TEXT] [--run-id RID] [--checkpoint-id CID]
  holloway contract-attach <contract_id> --file PATH [--note TEXT]
  holloway contract-link <contract_id> --project PID --task TID
  holloway contract-unlink <contract_id> --project PID --task TID
  holloway contract-relations <contract_id>
  holloway contract-relate <contract_id> --to OTHER_ID --type continues|supersedes|delegates_to [--note TEXT]
  holloway contract-unrelate <contract_id> --to OTHER_ID --type TYPE

  Dependencies:
  holloway deps <project_id> <task_id>
  holloway dep-add <project_id> <task_id> [--type TYPE] (--blocks <task_id> | --blocked-by <task_id> | --relates-to <task_id> | --sequence-after <task_id>)
  holloway dep-remove <project_id> <task_id> [--type TYPE] (--blocks <task_id> | --blocked-by <task_id> | --relates-to <task_id> | --sequence-after <task_id>)

  Task-Contract Links:
  holloway task-contracts <project_id> <task_id>
  holloway task-link <project_id> <task_id> --contract <contract_id>
  holloway task-unlink <project_id> <task_id> --contract <contract_id>
"""

import argparse
import hashlib
import hmac
import json
import mimetypes
import os
import sys
import time
import urllib.request
import urllib.error
import urllib.parse
import uuid

# Configuration
def env(suffix, default=""):
    """Read HOLLOWAY_<suffix>, falling back to the pre-rename A2A_<suffix>."""
    return os.environ.get(f"HOLLOWAY_{suffix}") or os.environ.get(f"A2A_{suffix}") or default


BASE_URL = env("BASE_URL", "https://holloway.montytorr.com")
API_KEY = env("API_KEY")
SIGNING_SECRET = env("SIGNING_SECRET")

# Canonical enums mirrored from current API/docs surfaces.
TASK_STATUSES = {"backlog", "todo", "in-progress", "in-review", "done", "cancelled"}
TASK_PRIORITIES = {"urgent", "critical", "high", "medium", "low"}
RUN_STATUSES = {"queued", "starting", "running", "pending-approval", "waiting", "blocked", "paused", "handoff-needed", "succeeded", "failed", "cancelled"}

# Operator channel — humans leave standing NOTES an agent re-reads on every
# contract read, and agents ask people QUESTIONS. Mirrors
# OPERATOR_QUESTION_KINDS in src/lib/contract-operator-channel.ts.
QUESTION_KINDS = ["question", "validation", "blocked"]
QUESTION_STATUSES = ["open", "answered", "dismissed"]


def read_text_argument(value: str | None, label: str) -> str | None:
    """Resolve prose that is too long or too structured to sit on a command line.

    '@path' reads a file and '-' reads stdin; anything else is used verbatim.

    Markdown needs real newlines, and a shell single-quoted string does not
    expand '\\n' - it stores a literal backslash and an n, which the API now
    refuses. Passing a file is the only comfortable way to write a heading, a
    bullet list and a blank line, so every prose argument accepts one.
    """
    if value is None:
        return None
    if value == "-":
        return sys.stdin.read()
    if value.startswith("@"):
        path = value[1:]
        try:
            with open(path, "r", encoding="utf-8") as handle:
                return handle.read()
        except OSError as exc:
            print(f"Error: cannot read {label} from {path}: {exc}", file=sys.stderr)
            sys.exit(1)
    return value


def normalize_task_status(value: str | None) -> str | None:
    """Normalize task status input for API compatibility while accepting legacy aliases."""
    if not value:
        return value
    normalized = value.strip()
    if not normalized:
        return value
    normalized = normalized.replace("_", "-")
    if normalized in TASK_STATUSES:
        return normalized
    return value.strip()


def normalize_task_priority(value: str | None) -> str | None:
    """Normalize task priority input for API compatibility (legacy alias: critical -> urgent)."""
    if not value:
        return value
    normalized = value.strip().lower()
    if normalized == "critical":
        return "urgent"
    return normalized


def sign_request(method: str, path: str, body: str = "") -> dict:
    """Generate HMAC-SHA256 signed headers with nonce replay protection."""
    timestamp = str(int(time.time()))
    nonce = str(uuid.uuid4())
    message = f"{method}\n{path}\n{timestamp}\n{nonce}\n{body}"
    signature = hmac.new(
        SIGNING_SECRET.encode(),
        message.encode(),
        hashlib.sha256,
    ).hexdigest()
    return {
        "X-API-Key": API_KEY,
        "X-Timestamp": timestamp,
        "X-Nonce": nonce,
        "X-Signature": signature,
        "Content-Type": "application/json",
    }


def api_request(method: str, path: str, body: dict | None = None) -> dict:
    """Make an authenticated API request."""
    if not API_KEY or not SIGNING_SECRET:
        print("Error: HOLLOWAY_API_KEY and HOLLOWAY_SIGNING_SECRET must be set (A2A_API_KEY / A2A_SIGNING_SECRET are still accepted)", file=sys.stderr)
        sys.exit(1)

    body_str = json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False) if body else ""
    url = f"{BASE_URL}{path}"
    # HMAC signs a canonical path (pathname only, normalized).
    sign_path = urllib.parse.urlparse(path).path or "/"
    if sign_path != "/":
        sign_path = sign_path.rstrip("/")
    headers = sign_request(method, sign_path, body_str)

    req = urllib.request.Request(
        url,
        data=body_str.encode() if body_str else None,
        headers=headers,
        method=method,
    )

    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        try:
            err = json.loads(e.read().decode())
            print(f"Error {e.code}: {err.get('error', 'Unknown error')}", file=sys.stderr)
            if err.get("details"):
                print(f"  Details: {err['details']}", file=sys.stderr)
        except Exception:
            print(f"Error {e.code}: {e.reason}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Connection error: {e.reason}", file=sys.stderr)
        sys.exit(1)


def _multipart_encode(fields: dict[str, str], file_field: str, file_path: str) -> tuple[bytes, str, str]:
    """Build multipart/form-data payload and canonical signing body for string fields."""
    boundary = f"----holloway-{uuid.uuid4().hex}"
    file_name = os.path.basename(file_path)
    mime = mimetypes.guess_type(file_name)[0] or "application/octet-stream"
    data = bytearray()

    def _add(text: str):
        data.extend(text.encode("utf-8"))

    for key in sorted(fields.keys()):
        value = fields[key]
        _add(f"--{boundary}\r\n")
        _add(f'Content-Disposition: form-data; name="{key}"\r\n\r\n')
        _add(f"{value}\r\n")

    with open(file_path, "rb") as f:
        file_bytes = f.read()

    _add(f"--{boundary}\r\n")
    _add(f'Content-Disposition: form-data; name="{file_field}"; filename="{file_name}"\r\n')
    _add(f"Content-Type: {mime}\r\n\r\n")
    data.extend(file_bytes)
    _add("\r\n")
    _add(f"--{boundary}--\r\n")

    # Multipart requests sign an EMPTY body. The server validates the HMAC before
    # parsing the multipart payload (src/lib/middleware-auth.ts), deliberately, so
    # that it never runs the parser on unauthenticated input — which means the
    # form fields are not part of the signed material. Signing a canonical JSON of
    # the fields here instead made every upload fail with 401 Invalid signature.
    return bytes(data), boundary, ""


def multipart_request(method: str, path: str, fields: dict[str, str], file_field: str, file_path: str) -> dict:
    """Make an authenticated multipart/form-data request."""
    if not API_KEY or not SIGNING_SECRET:
        print("Error: HOLLOWAY_API_KEY and HOLLOWAY_SIGNING_SECRET must be set (A2A_API_KEY / A2A_SIGNING_SECRET are still accepted)", file=sys.stderr)
        sys.exit(1)
    if not os.path.exists(file_path) or not os.path.isfile(file_path):
        print(f"Error: file not found: {file_path}", file=sys.stderr)
        sys.exit(1)

    payload, boundary, signing_body = _multipart_encode(fields, file_field, file_path)
    url = f"{BASE_URL}{path}"
    sign_path = urllib.parse.urlparse(path).path or "/"
    if sign_path != "/":
        sign_path = sign_path.rstrip("/")
    headers = sign_request(method, sign_path, signing_body)
    headers["Content-Type"] = f"multipart/form-data; boundary={boundary}"

    req = urllib.request.Request(url, data=payload, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        try:
            err = json.loads(e.read().decode())
            print(f"Error {e.code}: {err.get('error', 'Unknown error')}", file=sys.stderr)
            if err.get("details"):
                print(f"  Details: {err['details']}", file=sys.stderr)
        except Exception:
            print(f"Error {e.code}: {e.reason}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Connection error: {e.reason}", file=sys.stderr)
        sys.exit(1)


def resolve_agent_id(name_or_id: str) -> str:
    """Resolve an agent name to its UUID. If already a UUID, return as-is."""
    # Quick UUID check (8-4-4-4-12 hex pattern)
    if len(name_or_id) == 36 and name_or_id.count("-") == 4:
        return name_or_id
    try:
        result = api_request("GET", "/api/v1/agents")
        agents = result.get("data", result) if isinstance(result, dict) else result
        for a in agents:
            if not isinstance(a, dict):
                continue
            agent_name = str(a.get("name", "")).strip().lower()
            agent_display = str(a.get("display_name", "")).strip().lower()
            agent_owner = str(a.get("owner", "")).strip().lower()
            if (
                agent_name == name_or_id.lower()
                or agent_display == name_or_id.lower()
                or agent_owner == name_or_id.lower()
                or a.get("id", "") == name_or_id
            ):
                return a["id"]
    except Exception:
        pass
    return name_or_id  # Fall through — let the API error if invalid


def link_hint(contract_id: str) -> str:
    """Nudge shown when a contract has no project task behind it.

    Unlinked contracts cannot take attachments and do not appear on any board,
    so the work they describe is invisible to everyone not reading the thread.
    """
    return (
        "\n💡 This contract is not linked to a project task, so it has no board,\n"
        "   no execution tracking, and cannot take attachments.\n"
        "   Link it to existing work:\n"
        f"     holloway contract-link {contract_id} --project <project_id> --task <task_id>\n"
        "   Or start a project for it:\n"
        "     holloway project-create \"<title>\" --members <agent>...\n"
        "     holloway task-create <project_id> \"<task title>\"\n"
    )


LINK_PHRASING = {
    ("continues", "outgoing"): "Continues",
    ("continues", "incoming"): "Continued by",
    ("supersedes", "outgoing"): "Supersedes",
    ("supersedes", "incoming"): "Superseded by",
    ("delegates_to", "outgoing"): "Delegates to",
    ("delegates_to", "incoming"): "Delegated from",
}


def format_related_contract(link: dict) -> str:
    """One related contract, read from the end you are standing on."""
    phrase = LINK_PHRASING.get((link.get("link_type"), link.get("direction")), link.get("link_type", "?"))
    line = f"{phrase}: {link.get('title', '?')} [{str(link.get('status', '?')).upper()}]"
    line += f"\n      {link.get('contract_id')}"
    if link.get("note"):
        line += f"\n      {link['note']}"
    return line


def _indent_block(text: str, prefix: str = "   ") -> str:
    """Indent a possibly multi-line body so it reads as one block, not one line."""
    lines = str(text or "").splitlines() or [""]
    return "\n".join(f"{prefix}{line}" for line in lines)


def describe_channel_state(counts: dict | None) -> str | None:
    """The one-line operator-channel nudge, or None when there is nothing to say.

    Mirrors `describeChannelState` in src/lib/contract-operator-channel.ts word
    for word, so the CLI and the API never disagree about what is outstanding.
    """
    if not counts:
        return None
    parts = []
    unacked = counts.get("unacknowledged_notes")
    if unacked:
        parts.append(
            f"{unacked} operator note{'' if unacked == 1 else 's'} you have not acknowledged"
        )
    open_questions = counts.get("open_questions")
    if open_questions:
        blocking_count = counts.get("blocking_questions")
        blocking = f", {blocking_count} blocking" if blocking_count else ""
        parts.append(
            f"{open_questions} open question{'' if open_questions == 1 else 's'} to a human{blocking}"
        )
    return "; ".join(parts) if parts else None


def format_channel_counts(counts: dict | None) -> str:
    """The counts line printed under a notes or questions listing."""
    counts = counts or {}
    notes = counts.get("notes", 0)
    unacked = counts.get("unacknowledged_notes")
    open_questions = counts.get("open_questions", 0)
    blocking = counts.get("blocking_questions", 0)
    # `unacknowledged_notes` is null when the server could not identify a
    # viewer. Printing "0 unacknowledged" there would claim they are all read.
    unacked_text = "acknowledgement unknown" if unacked is None else f"{unacked} unacknowledged"
    return (
        f"Operator channel: {notes} note{'' if notes == 1 else 's'} ({unacked_text}), "
        f"{open_questions} open question{'' if open_questions == 1 else 's'} to a human "
        f"({blocking} blocking)"
    )


def format_operator_note(n: dict) -> str:
    """One standing instruction from a human, and whether this agent has read it."""
    acknowledged = n.get("acknowledged")
    if acknowledged is True:
        ack = "acknowledged"
    elif acknowledged is False:
        ack = "NOT acknowledged"
    else:
        ack = "acknowledgement unknown"
    author = n.get("author_name") or "Unknown"
    ts = str(n.get("created_at") or "")[:16].replace("T", " ")
    line = f"📌 {author} — {ts} | {ack}"
    line += f"\n   ID: {n.get('id', '?')}"
    updated = n.get("updated_at")
    if updated and updated != n.get("created_at"):
        line += f"\n   Edited: {str(updated)[:16].replace('T', ' ')}"
    line += f"\n{_indent_block(n.get('body', ''))}"
    return line


def format_operator_question(q: dict) -> str:
    """One question an agent put to a person, with the answer when there is one."""
    status = str(q.get("status") or "?")
    icon = {"open": "❓", "answered": "✅", "dismissed": "🚫"}.get(status, "❓")
    blocking = "BLOCKING" if q.get("blocking") else "non-blocking"
    asker = q.get("asked_by_agent_name") or q.get("asked_by_agent_id") or "?"
    ts = str(q.get("created_at") or "")[:16].replace("T", " ")
    line = f"{icon} [{status.upper()}] {q.get('kind', 'question')} — {blocking}"
    line += f"\n   Asked by: {asker} — {ts}"
    line += f"\n   ID: {q.get('id', '?')}"
    line += f"\n{_indent_block(q.get('body', ''))}"
    if q.get("answer"):
        who = q.get("answered_by_name") or "a human"
        when = str(q.get("answered_at") or "")[:16].replace("T", " ")
        line += f"\n   ↩ Answered by {who}" + (f" — {when}" if when else "") + ":"
        line += f"\n{_indent_block(q['answer'], '      ')}"
    elif status in ("answered", "dismissed"):
        # Resolved without text. Say so rather than printing nothing, which
        # would read as an unanswered question.
        who = q.get("answered_by_name") or "a human"
        line += f"\n   ↩ {status.capitalize()} by {who} with no answer text"
    return line


def format_contract(c: dict, verbose: bool = False) -> str:
    """Format a contract for display."""
    status_icons = {
        "proposed": "📋",
        "active": "🟢",
        "closed": "⬛",
        "rejected": "❌",
        "expired": "⏰",
        "cancelled": "🚫",
    }
    icon = status_icons.get(c["status"], "❓")
    parts = c.get("participants", [])
    agent_names = []
    for p in parts:
        if not isinstance(p, dict):
            continue
        participant_agent = p.get("agent") if isinstance(p.get("agent"), dict) else {}
        name = participant_agent.get("display_name") or participant_agent.get("name") or p.get("agent_id")
        if name:
            agent_names.append(name)
    agents = ", ".join(agent_names)
    turns = f"{c['current_turns']}/{c['max_turns']}"

    linked = c.get("linked_task") if isinstance(c.get("linked_task"), dict) else None

    line = f"{icon} [{c['status'].upper()}] {c['title']}"
    line += f"\n   ID: {c['id']}"
    line += f"\n   Participants: {agents} | Turns: {turns}"
    if c.get("completion_requires_approval"):
        approval = "approved" if c.get("completion_approved_at") else "required"
        line += f" | Completion approval: {approval}"
    if linked:
        project = linked.get("project_title") or linked.get("project_id")
        task = linked.get("task_title") or linked.get("task_id")
        line += f"\n   Project: {project} › {task}"
        if linked.get("task_status"):
            line += f" [{linked['task_status']}]"
    elif verbose:
        # The nudge existed only at propose time, which is the moment an agent
        # is least likely to have a task yet. `holloway inbox` is where attention
        # actually is, so say it there too.
        line += "\n   No project — not on any board, no execution tracking, cannot take attachments"
        line += f"\n   Fix: holloway contract-link {c['id']} --project <project_id> --task <task_id>"

    turn_state = c.get("turn_state") if isinstance(c.get("turn_state"), dict) else None
    if turn_state:
        # `human` is not a move anyone owes: an agent has said it is blocked and
        # asked a person, and nothing proceeds until that is answered.
        marker = {
            "you": "➜ YOUR MOVE",
            "peer": "waiting on peer",
            "nobody": "nothing owed",
            "human": "⏸ WAITING ON A PERSON",
        }.get(turn_state.get("awaiting"), "?")
        line += f"\n   {marker} — {turn_state.get('reason', '')}"

    # Standing notes are re-read on every contract read, so an unacknowledged
    # one is context this agent is acting without. Say so wherever a contract
    # is printed rather than only where it is asked for.
    channel = c.get("operator_channel") if isinstance(c.get("operator_channel"), dict) else None
    nudge = describe_channel_state(channel)
    if nudge:
        hints = []
        if channel.get("unacknowledged_notes"):
            hints.append(f"holloway notes {c['id']}")
        if channel.get("open_questions"):
            hints.append(f"holloway questions {c['id']}")
        line += f"\n   📣 {nudge}" + (f" ({' · '.join(hints)})" if hints else "")

    related = [link for link in (c.get("related_contracts") or []) if isinstance(link, dict)]
    if related:
        line += f"\n   Related contracts: {len(related)}"
        if not verbose:
            line += " (holloway contract-relations <id>)"

    if verbose:
        for link in related:
            line += f"\n   ↔ {format_related_contract(link)}"
        if c.get("description"):
            line += f"\n   Description: {c['description']}"
        if c.get("expires_at"):
            line += f"\n   Expires: {c['expires_at']}"
        if c.get("close_reason"):
            line += f"\n   Close reason: {c['close_reason']}"
        line += f"\n   Created: {c['created_at']}"

        # Show participant statuses
        for p in parts:
            if not isinstance(p, dict):
                continue
            pstatus = "✅" if p.get("status") == "accepted" else ("❌" if p.get("status") == "rejected" else "⏳")
            p_agent = p.get("agent") if isinstance(p.get("agent"), dict) else {}
            name = p_agent.get("display_name") or p_agent.get("name") or p.get("agent_id")
            line += f"\n   {pstatus} {name} ({p.get('role', '?')}) — {p.get('status', '?')}"

    return line


def describe_expectation(m: dict) -> str:
    """What this message asks of whoever receives it."""
    if m.get("consumes_turn") is False:
        return "no turn, no reply expected"
    if m.get("requires_action") is False:
        return "informational — no reply expected"
    if m.get("message_type") == "request":
        return "REPLY EXPECTED"
    return "reply expected"


def format_message(m: dict) -> str:
    """Format a message for display."""
    sender = m.get("sender", {}).get("display_name", m.get("sender_id", "?"))
    turn = m.get("turn_number", "?")
    remaining = m.get("turns_remaining", "?")
    content_str = json.dumps(m["content"], indent=2)
    return (
        f"--- Turn {turn} (remaining: {remaining}) ---\n"
        f"From: {sender} | Type: {m['message_type']} | {describe_expectation(m)} | {m['created_at']}\n"
        f"{content_str}"
    )


def format_project(p: dict, verbose: bool = False) -> str:
    """Format a project for display."""
    status_icons = {
        "active": "🟢",
        "completed": "✅",
        "archived": "📦",
        "planning": "📐",
    }
    icon = status_icons.get(p.get("status", ""), "📁")
    status = p.get("status", "unknown").upper()
    line = f"{icon} [{status}] {p.get('title', '?')}"
    line += f"\n   ID: {p['id']}"

    members = p.get("members", [])
    if members:
        names = ", ".join(
            m.get("agent", {}).get("display_name", m.get("agent_id", "?"))
            for m in members
        )
        line += f"\n   Members: {names}"

    if verbose:
        if p.get("description"):
            line += f"\n   Description: {p['description']}"
        sprint_count = p.get("sprint_count", p.get("sprints_count"))
        if sprint_count is not None:
            line += f"\n   Sprints: {sprint_count}"
        task_stats = p.get("task_stats", p.get("task_count"))
        if isinstance(task_stats, dict):
            parts = [f"{k}: {v}" for k, v in task_stats.items()]
            line += f"\n   Tasks: {', '.join(parts)}"
        elif task_stats is not None:
            line += f"\n   Tasks: {task_stats}"
        line += f"\n   Created: {p.get('created_at', '?')}"
        if p.get("updated_at"):
            line += f"\n   Updated: {p['updated_at']}"

    return line


def format_sprint(s: dict, verbose: bool = False) -> str:
    """Format a sprint for display."""
    status_icons = {
        "planning": "📐",
        "active": "🏃",
        "completed": "✅",
        "cancelled": "🚫",
    }
    icon = status_icons.get(s.get("status", ""), "📋")
    status = s.get("status", "unknown").upper()
    line = f"{icon} [{status}] {s.get('title', '?')}"
    line += f"\n   ID: {s['id']}"

    dates = []
    if s.get("start_date"):
        dates.append(f"Start: {s['start_date']}")
    if s.get("end_date"):
        dates.append(f"End: {s['end_date']}")
    if dates:
        line += f"\n   {' | '.join(dates)}"

    if verbose:
        if s.get("goal"):
            line += f"\n   Goal: {s['goal']}"
        task_count = s.get("task_count")
        if task_count is not None:
            line += f"\n   Tasks: {task_count}"
        line += f"\n   Created: {s.get('created_at', '?')}"

    return line


def parse_json_arg(value: str, flag_name: str) -> dict:
    """Parse a JSON object flag value."""
    try:
        parsed = json.loads(value)
    except json.JSONDecodeError as e:
        print(f"Error: invalid JSON for {flag_name}: {e}", file=sys.stderr)
        sys.exit(1)
    if not isinstance(parsed, dict):
        print(f"Error: {flag_name} must be a JSON object", file=sys.stderr)
        sys.exit(1)
    return parsed


def _get_list_payload(payload: object, *keys: str) -> list:
    """Extract a list payload from either a raw list or wrapped response."""
    if isinstance(payload, list):
        return payload
    if not isinstance(payload, dict):
        return []
    if isinstance(payload.get("data"), list):
        return payload.get("data", [])
    for key in keys:
        value = payload.get(key)
        if isinstance(value, list):
            return value
    return []


def format_task(t: dict, verbose: bool = False) -> str:
    """Format a task for display."""
    status_icons = {
        "backlog": "🧺",
        "todo": "⬜",
        "in-progress": "🔵",
        "in-review": "🟡",
        "done": "✅",
        "cancelled": "❌",
    }
    priority_icons = {
        "critical": "🔴",
        "urgent": "🔴",
        "high": "🟠",
        "medium": "🟡",
        "low": "🟢",
    }
    icon = status_icons.get(t.get("status", ""), "📋")
    status = t.get("status", "unknown").upper()
    priority = t.get("priority", "")
    p_icon = priority_icons.get(priority, "")

    line = f"{icon} [{status}]"
    if p_icon:
        line += f" {p_icon}{priority.upper()}"
    line += f" {t.get('title', '?')}"
    line += f"\n   ID: {t['id']}"

    assignee = t.get("assignee", {})
    if assignee:
        name = assignee.get("display_name", assignee.get("agent_id", t.get("assignee_agent_id")))
        if name:
            line += f"\n   Assignee: {name}"

    labels = t.get("labels", [])
    if labels:
        line += f"\n   Labels: {', '.join(labels)}"

    if verbose:
        if t.get("description"):
            line += f"\n   Description: {t['description']}"
        if t.get("sprint_id"):
            line += f"\n   Sprint: {t['sprint_id']}"
        if t.get("due_date"):
            line += f"\n   Due: {t['due_date']}"
        execution_status = t.get("execution_status")
        if execution_status:
            line += f"\n   Execution: {execution_status}"
            if t.get("active_run_id"):
                line += f" (active run: {t['active_run_id']})"
        if t.get("execution_started_at"):
            line += f"\n   Run started: {t['execution_started_at']}"
        if t.get("execution_heartbeat_at"):
            line += f"\n   Last heartbeat: {t['execution_heartbeat_at']}"
        if t.get("execution_completed_at"):
            line += f"\n   Run completed: {t['execution_completed_at']}"
        if t.get("last_checkpoint_summary"):
            line += f"\n   Last checkpoint: {t['last_checkpoint_summary']}"
        blocked_by = t.get("blocked_by", [])
        blocks = t.get("blocks", [])
        if blocked_by:
            dep_ids = [d.get("id", d.get("blocking_task_id", "?")) for d in blocked_by]
            line += f"\n   Blocked by: {', '.join(dep_ids)}"
        if blocks:
            dep_ids = [d.get("id", d.get("blocked_task_id", "?")) for d in blocks]
            line += f"\n   Blocks: {', '.join(dep_ids)}"
        if t.get("blocked_at"):
            line += f"\n   Blocked at: {t['blocked_at']}"
        if t.get("blocker_resolution_action"):
            line += f"\n   Unblock plan: {t['blocker_resolution_action']}"
        if t.get("blocker_resolution_owner"):
            line += f"\n   Unblock owner: {t['blocker_resolution_owner']}"
        if t.get("blocker_resolution_due_at"):
            line += f"\n   Follow-up due: {t['blocker_resolution_due_at']}"
        if t.get("blocker_resolution_status"):
            line += f"\n   Blocker status: {t['blocker_resolution_status']}"
        if t.get("blocker_follow_up_at"):
            line += f"\n   Last follow-up: {t['blocker_follow_up_at']}"
        if t.get("blocker_escalated_at"):
            line += f"\n   Escalated at: {t['blocker_escalated_at']}"
        contracts = t.get("contracts", t.get("linked_contracts", []))
        if contracts:
            c_ids = [c.get("contract_id", c.get("id", "?")) for c in contracts]
            line += f"\n   Linked contracts: {', '.join(c_ids)}"
        line += f"\n   Created: {t.get('created_at', '?')}"

    return line


# ── Commands ──────────────────────────────────────────────

def cmd_health(_args):
    """Check API health (no auth required)."""
    url = f"{BASE_URL}/api/v1/health"
    req = urllib.request.Request(url)
    with urllib.request.urlopen(req, timeout=10) as resp:
        data = json.loads(resp.read().decode())
    print(json.dumps(data, indent=2))


def cmd_status(_args):
    """Check system status (no auth required)."""
    url = f"{BASE_URL}/api/v1/status"
    req = urllib.request.Request(url)
    with urllib.request.urlopen(req, timeout=10) as resp:
        data = json.loads(resp.read().decode())
    ks = data.get("kill_switch", {})
    frozen = "🔴 FROZEN" if ks.get("active") else "🟢 OPERATIONAL"
    print(f"System: {frozen}")
    if ks.get("active"):
        print(f"  Activated by: {ks.get('activated_by', '?')}")
        print(f"  Activated at: {ks.get('activated_at', '?')}")


def cmd_agents(_args):
    """List all registered agents."""
    data = api_request("GET", "/api/v1/agents")
    agents = data if isinstance(data, list) else data.get("data", data.get("agents", []))
    for a in agents:
        line = f"  {a['display_name']} ({a['name']}) — owner: {a['owner']}"
        caps = a.get("capabilities", [])
        if caps:
            line += f" | capabilities: {', '.join(caps)}"
        print(line)


def cmd_agent(args):
    """Get agent details."""
    agent_id = resolve_agent_id(args.id)
    data = api_request("GET", f"/api/v1/agents/{agent_id}")
    print(f"Agent: {data.get('display_name', '?')} ({data.get('name', '?')})")
    print(f"  ID:          {data.get('id', '?')}")
    print(f"  Owner:       {data.get('owner', '?')}")
    if data.get("description"):
        print(f"  Description: {data['description']}")
    caps = data.get("capabilities", [])
    print(f"  Capabilities: {', '.join(caps) if caps else '(none)'}")
    protocols = data.get("protocols", [])
    print(f"  Protocols:    {', '.join(protocols) if protocols else '(none)'}")
    print(f"  Max concurrent contracts: {data.get('max_concurrent_contracts', '?')}")
    if data.get('trust_tier') is not None:
        print(f"  Trust tier:  {data.get('trust_tier', '?')}")
    if data.get('trust_notes'):
        print(f"  Trust notes: {data.get('trust_notes')}")
    if data.get('trust_policy') is not None:
        print("  Trust policy:")
        print(json.dumps(data.get('trust_policy'), indent=2))
    print(f"  Created:     {data.get('created_at', '?')}")
    print(f"  Updated:     {data.get('updated_at', '?')}")


def cmd_contracts(args):
    """List contracts."""
    params = []
    if args.status:
        params.append(f"status={args.status}")
    if args.role:
        params.append(f"role={args.role}")
    if getattr(args, "awaiting", None):
        params.append(f"awaiting={args.awaiting}")
    if args.page:
        params.append(f"page={args.page}")
    query = f"?{'&'.join(params)}" if params else ""
    data = api_request("GET", f"/api/v1/contracts{query}")
    contracts = data.get("data", [])
    total = data.get("total", len(contracts))
    print(f"Contracts ({total} total):\n")
    for c in contracts:
        print(format_contract(c))
        print()


def cmd_contract(args):
    """Get contract details."""
    data = api_request("GET", f"/api/v1/contracts/{args.id}")
    print(format_contract(data, verbose=True))


def cmd_contract_describe(args):
    """Rewrite a contract's description."""
    description = read_text_argument(args.description, "description")
    data = api_request(
        "PATCH",
        f"/api/v1/contracts/{args.id}",
        {"description": description},
    )
    print(f"✓ Description updated for contract {args.id}")
    print(format_contract(data, verbose=True))


def cmd_propose(args):
    """Propose a new contract."""
    body = {
        "title": args.title,
        "invitees": args.to,
    }
    description = read_text_argument(args.description, "description")
    if description:
        body["description"] = description
    if args.max_turns:
        body["max_turns"] = args.max_turns
    if args.require_completion_approval:
        body["completion_requires_approval"] = True
    if args.expires_hours:
        body["expires_in_hours"] = args.expires_hours
    if args.schema:
        schema_str = args.schema
        # If it looks like a file path, read it
        if os.path.isfile(schema_str):
            with open(schema_str, "r") as f:
                schema_str = f.read()
        try:
            body["message_schema"] = json.loads(schema_str)
        except json.JSONDecodeError:
            print("Error: --schema must be valid JSON or a path to a JSON file", file=sys.stderr)
            sys.exit(1)

    if bool(args.project) != bool(args.task):
        print("Error: --project and --task must be used together", file=sys.stderr)
        sys.exit(1)
    if args.project and args.task:
        body["project_id"] = args.project
        body["task_id"] = args.task

    data = api_request("POST", "/api/v1/contracts", body)
    print(f"✅ Contract proposed!")
    print(format_contract(data, verbose=True))
    if not data.get("linked_task"):
        print(link_hint(data.get("id", "<contract_id>")))


def cmd_accept(args):
    """Accept a contract invitation."""
    data = api_request("POST", f"/api/v1/contracts/{args.id}/accept")
