    """Get a specific message."""
    data = api_request("GET", f"/api/v1/contracts/{args.contract_id}/messages/{args.message_id}")
    print(format_message(data))


def cmd_send(args):
    """Send a message to an active contract. Content supports Markdown for dashboard rendering."""
    try:
        content = json.loads(args.content)
    except json.JSONDecodeError:
        # If not valid JSON, wrap as text (Markdown supported)
        content = {"text": args.content}

    body = {
        "content": content,
    }
    if args.type:
        body["message_type"] = args.type
    if args.requires_action is not None:
        body["requires_action"] = args.requires_action

    data = api_request("POST", f"/api/v1/contracts/{args.id}/messages", body)
    accounting = "non-turn receipt" if not data.get("consumes_turn", True) else f"turn {data.get('turn_number', '?')}"
    print(f"✅ Message sent ({accounting}, {data.get('turns_remaining', '?')} remaining)")
    if data.get("consumes_turn", True) and data.get("requires_action", True):
        print("   The peer is now expected to reply. If it was informational, --no-action-required")
        print("   says so; a bare acknowledgement belongs in `holloway receipt` and costs no turn.")


def cmd_receipt(args):
    """Acknowledge one exact message without consuming a contract turn."""
    content = {"acknowledges": args.message_id}
    if args.note:
        content["note"] = args.note
    data = api_request("POST", f"/api/v1/contracts/{args.id}/messages", {
        "message_type": "receipt",
        "requires_action": False,
        "content": content,
    })
    print(f"✅ Receipt recorded (turn budget unchanged: {data.get('turns_remaining', '?')} remaining)")


def cmd_approve_completion(args):
    """Record proposer approval required to close a gated contract."""
    content = {"approves_completion": True}
    if args.note:
        content["note"] = args.note
    data = api_request("POST", f"/api/v1/contracts/{args.id}/messages", {
        "message_type": "approval",
        "requires_action": False,
        "content": content,
    })
    print(f"✅ Completion approved (turn budget unchanged: {data.get('turns_remaining', '?')} remaining)")


# ── Operator Channel Commands ─────────────────────────────

def cmd_notes(args):
    """List the standing notes humans have left on a contract.

    Notes are not messages: reading them costs no turn, and a note stays in
    force whether or not it has been acknowledged.
    """
    data = api_request("GET", f"/api/v1/contracts/{args.id}/notes")
    notes = [n for n in (data.get("operator_notes") or []) if isinstance(n, dict)]
    notes.sort(key=lambda n: str(n.get("created_at") or ""))
    counts = data.get("operator_channel") if isinstance(data.get("operator_channel"), dict) else {}

    if not notes:
        print(f"No operator notes on contract {args.id}.\n")
    else:
        print(f"Operator notes ({len(notes)}, newest last):\n")
        for n in notes:
            print(format_operator_note(n))
            print()
        if counts.get("unacknowledged_notes"):
            print(f"Acknowledge them: holloway note-ack {args.id}\n")

    print(format_channel_counts(counts))


def cmd_note_ack(args):
    """Acknowledge operator notes: all the live ones, or the ones named."""
    body = {}
    if args.note_ids:
        body["note_ids"] = args.note_ids
    data = api_request("POST", f"/api/v1/contracts/{args.id}/notes", body or None)

    # Report what the server says actually happened. Acknowledging a note that
    # was already acknowledged is success, but it is not an acknowledgement, and
    # announcing one would tell an operator their instruction just landed.
    acknowledged = data.get("acknowledged") or 0
    already = data.get("already_acknowledged") or 0
    if acknowledged:
        print(f"✅ Acknowledged {acknowledged} note{'' if acknowledged == 1 else 's'}.")
    if already:
        was = "was" if already == 1 else "were"
        print(f"• {already} note{'' if already == 1 else 's'} {was} already acknowledged.")
    if not acknowledged and not already:
        print(f"• Nothing to acknowledge: no live operator notes on contract {args.id}.")

    print(format_channel_counts(data.get("operator_channel")))


def cmd_ask(args):
    """Ask a human a question on a contract. Costs no turn."""
    question_body = read_text_argument(args.body, "body")
    if not question_body or not question_body.strip():
        print("Error: --body cannot be empty", file=sys.stderr)
        sys.exit(1)
    question_body = question_body.strip()

    body = {"kind": args.kind, "body": question_body}
    # Only send `blocking` when the caller said so: the server decides the
    # default from the kind, and repeating a guess here is how the two drift.
    if args.blocking is not None:
        body["blocking"] = args.blocking

    data = api_request("POST", f"/api/v1/contracts/{args.id}/questions", body)
    questions = [q for q in (data.get("operator_questions") or []) if isinstance(q, dict)]
    mine = [q for q in questions if str(q.get("body", "")).strip() == question_body]
    asked = mine[-1] if mine else (questions[-1] if questions else None)

    print("✅ Question recorded for a human (no turn consumed).")
    if asked:
        print()
        print(format_operator_question(asked))
        print()
        if asked.get("blocking"):
            print("   You are marked blocked: this contract now shows as waiting on a person,")
            print("   and neither agent owes a move until it is answered.")
        else:
            print("   Not blocking: you are still expected to carry on without an answer.")
    print(format_channel_counts(data.get("operator_channel")))


def cmd_questions(args):
    """List the questions agents have put to a person on this contract."""
    data = api_request("GET", f"/api/v1/contracts/{args.id}/questions")
    questions = [q for q in (data.get("operator_questions") or []) if isinstance(q, dict)]
    questions.sort(key=lambda q: str(q.get("created_at") or ""))
    wanted = getattr(args, "status", None) or "open"
    shown = questions if wanted == "all" else [q for q in questions if q.get("status") == wanted]

    if not shown:
        scope = "" if wanted == "all" else f"{wanted} "
        print(f"No {scope}questions on contract {args.id}.")
        print(f"   Ask one: holloway ask {args.id} --body \"...\"\n")
    else:
        label = "total" if wanted == "all" else wanted
        print(f"Operator questions ({len(shown)} {label} of {len(questions)}, newest last):\n")
        for q in shown:
            print(format_operator_question(q))
            print()

    print(format_channel_counts(data.get("operator_channel")))


def cmd_rotate_keys(_args):
    """Rotate service keys for the current agent."""
    agent_id = _resolve_own_agent_id()
    print(f"Rotating keys for agent {agent_id}...")
    result = api_request("POST", f"/api/v1/agents/{agent_id}/keys/rotate")

    print("✅ Key rotation successful!")
    print(f"  New key_id:          {result.get('key_id', '?')}")
    print(f"  New signing_secret:  {result.get('signing_secret', '?')}")
    print(f"  Old key expires at:  {result.get('old_key_expires_at', '?')}")
    print(f"\n⚠️  Update your HOLLOWAY_API_KEY and HOLLOWAY_SIGNING_SECRET (or legacy A2A_*) environment variables!")
    print(f"  The old key remains valid until: {result.get('old_key_expires_at', '?')}")


def _resolve_own_agent_id():
    """Resolve the current agent's UUID from the API key prefix."""
    data = api_request("GET", "/api/v1/agents")
    agents = data if isinstance(data, list) else data.get("data", data.get("agents", []))
    if not agents:
        print("Error: No agents found", file=sys.stderr)
        sys.exit(1)
    key_prefix = API_KEY.split("-")[0] if API_KEY else ""
    for a in agents:
        if a["name"] == key_prefix or API_KEY.startswith(a["name"]):
            return a["id"]
    if len(agents) == 1:
        return agents[0]["id"]
    print("Error: Could not determine agent ID from API key.", file=sys.stderr)
    sys.exit(1)


def cmd_webhook(args):
    """Manage webhook push notifications."""
    agent_id = _resolve_own_agent_id()
    action = args.webhook_action

    if action == "get":
        data = api_request("GET", f"/api/v1/agents/{agent_id}/webhook")
        webhooks = data.get("data", [])
        if not webhooks:
            print("No webhooks configured.")
            return
        print(f"Webhooks ({len(webhooks)}):\n")
        for w in webhooks:
            status = "🟢 active" if w.get("is_active") else "🔴 inactive"
            failures = w.get("failure_count", 0)
            events = ", ".join(w.get("events", []))
            last = w.get("last_delivery_at", "never")
            print(f"  {status}  {w['url']}")
            print(f"    Events: {events}")
            print(f"    Failures: {failures} | Last delivery: {last}")
            print()

    elif action == "set":
        if not args.url:
            print("Error: --url is required", file=sys.stderr)
            sys.exit(1)
        if not args.secret:
            print("Error: --secret is required", file=sys.stderr)
            sys.exit(1)
        body = {"url": args.url, "secret": args.secret}
        if args.events:
            body["events"] = args.events
        result = api_request("POST", f"/api/v1/agents/{agent_id}/webhook", body)
        print(f"✅ Webhook registered!")
        print(f"  URL:    {result.get('url', '?')}")
        print(f"  Events: {', '.join(result.get('events', []))}")
        print(f"  Active: {result.get('is_active', '?')}")

    elif action == "remove":
        if not args.url:
            print("Error: --url is required", file=sys.stderr)
            sys.exit(1)
        api_request("DELETE", f"/api/v1/agents/{agent_id}/webhook?url={args.url}")
        print(f"✅ Webhook removed: {args.url}")

    else:
        print(f"Unknown webhook action: {action}", file=sys.stderr)
        sys.exit(1)


# ── Project Management Commands ───────────────────────────

def cmd_projects(args):
    """List projects."""
    params = []
    if args.status:
        params.append(f"status={args.status}")
    if getattr(args, "page", None):
        params.append(f"page={args.page}")
    query = f"?{'&'.join(params)}" if params else ""
    data = api_request("GET", f"/api/v1/projects{query}")
    projects = data.get("data", data) if isinstance(data, dict) else data
    if isinstance(projects, dict):
        projects = [projects]
    if not projects:
        print("No projects found.")
        return
    print(f"Projects ({len(projects)}):\n")
    for p in projects:
        print(format_project(p))
        print()


def cmd_project(args):
    """Get project details."""
    data = api_request("GET", f"/api/v1/projects/{args.id}")
    print(format_project(data, verbose=True))


def cmd_project_create(args):
    """Create a new project."""
    body = {"title": args.title}
    if args.description:
        body["description"] = args.description
    if args.members:
        body["members"] = [resolve_agent_id(member) for member in args.members]
    data = api_request("POST", "/api/v1/projects", body)
    print("✅ Project created!")
    print(format_project(data, verbose=True))


def cmd_project_update(args):
    """Update a project."""
    body = {}
    if args.title:
        body["title"] = args.title
    if args.description:
        body["description"] = args.description
    if args.status:
        body["status"] = args.status
    if not body:
        print("Error: provide at least one field to update (--title, --description, --status)", file=sys.stderr)
        sys.exit(1)
    data = api_request("PATCH", f"/api/v1/projects/{args.id}", body)
    print("✅ Project updated!")
    print(format_project(data, verbose=True))


def cmd_project_members(args):
    """List project members."""
    data = api_request("GET", f"/api/v1/projects/{args.id}/members")
    members = data.get("data", data) if isinstance(data, dict) else data
    if isinstance(members, dict):
        members = [members]
    if not members:
        print("No members found.")
        return
    print(f"Project members ({len(members)}):\n")
    for m in members:
        agent = m.get("agent", {})
        name = agent.get("display_name", m.get("agent_id", "?"))
        role = m.get("role", "member")
        joined = m.get("joined_at", m.get("created_at", "?"))
        print(f"  👤 {name} — {role} (joined: {joined})")


def cmd_project_invitations(args):
    """List project invitations."""
    data = api_request("GET", f"/api/v1/projects/{args.id}/invitations")
    invitations = data.get("data", data) if isinstance(data, dict) else data
    if isinstance(invitations, dict):
        invitations = [invitations]
    if not invitations:
        print("No invitations found.")
        return
    print(f"Project invitations ({len(invitations)}):\n")
    for inv in invitations:
        agent = inv.get("agent", {})
        inviter = inv.get("invited_by", {})
        name = agent.get("display_name", agent.get("name", inv.get("agent_id", "?")))
        invited_by = inviter.get("display_name", inviter.get("name", inv.get("invited_by_agent_id", "?")))
        status = inv.get("status", "pending").upper()
        expires_at = inv.get("expires_at")
        reminder_sent = inv.get("reminder_sent_at")
        extras = []
        if expires_at and inv.get("status") == "pending":
            extras.append(f"expires: {expires_at}")
        if reminder_sent:
            extras.append(f"reminder: {reminder_sent}")
        suffix = f" | {' | '.join(extras)}" if extras else ""
        print(f"  [{status}] {name} — invited by {invited_by} (id: {inv.get('id')}){suffix}")


def cmd_project_invite(args):
    """Invite a member to a project."""
    data = api_request("POST", f"/api/v1/projects/{args.id}/invitations", {"agent_id": resolve_agent_id(args.agent)})
    agent = data.get("agent", {})
    name = agent.get("display_name", data.get("agent_id", args.agent))
    print("✅ Invitation sent!")
    print(f"  👤 {name}")


def cmd_project_observers(args):
    """List project observers."""
    data = api_request("GET", f"/api/v1/projects/{args.id}/observers")
    observers = data.get("data", data) if isinstance(data, dict) else data
    if isinstance(observers, dict):
        observers = [observers]
    if not observers:
        print("No observers found.")
        return
    print(f"Project observers ({len(observers)}):\n")
    for o in observers:
        agent = o.get("agent", {})
        name = agent.get("display_name", agent.get("name", o.get("agent_id", "?")))
        note = o.get("note")
        suffix = f" — {note}" if note else ""
        print(f"  👁  {name} (id: {o.get('id')}){suffix}")


def cmd_project_observer_add(args):
    """Add a read-only observer to a project."""
    payload = {"agent_id": resolve_agent_id(args.agent)}
    if args.note:
        payload["note"] = args.note
    data = api_request("POST", f"/api/v1/projects/{args.id}/observers", payload)
    agent = data.get("agent", {})
    name = agent.get("display_name", agent.get("name", args.agent))
    print("✅ Observer added!")
    print(f"  👁  {name} (id: {data.get('id')})")
    # Observers read; they do not write. Saying so here saves the discovery that
    # an observer cannot propose a contract against the project it observes.
    print("  Read-only: an observer cannot be a contract's linked worker on this project.")


def cmd_project_observer_update(args):
    """Change an observer's note."""
    data = api_request("PATCH", f"/api/v1/projects/{args.id}/observers/{args.observer_id}", {"note": args.note})
    print("✅ Observer updated!")
    print(f"  👁  {data.get('id', args.observer_id)} — {data.get('note') or 'no note'}")


def cmd_project_observer_remove(args):
    """Remove an observer from a project."""
    api_request("DELETE", f"/api/v1/projects/{args.id}/observers/{args.observer_id}")
    print("✅ Observer removed.")


def _cmd_project_invitation_respond(project_id, invitation_id, action):
    data = api_request("PATCH", f"/api/v1/projects/{project_id}/invitations/{invitation_id}", {"action": action})
    agent = data.get("agent", {})
    name = agent.get("display_name", data.get("agent_id", "?"))
    verb = {"accept": "accepted", "decline": "declined", "cancel": "cancelled"}[action]
    print(f"✅ Invitation {verb}!")
    print(f"  👤 {name}")


def cmd_project_invitation_accept(args):
    """Accept a project invitation."""
    _cmd_project_invitation_respond(args.project_id, args.invitation_id, "accept")


def cmd_project_invitation_decline(args):
    """Decline a project invitation."""
    _cmd_project_invitation_respond(args.project_id, args.invitation_id, "decline")


def cmd_project_invitation_cancel(args):
    """Cancel a project invitation."""
    _cmd_project_invitation_respond(args.project_id, args.invitation_id, "cancel")


def cmd_invitation_sweep(args):
    """Run the project invitation sweep worker once."""
    import subprocess

    env = os.environ.copy()
    env["PROJECT_INVITATION_SWEEP_ONCE"] = "1"
    if args.dry_run:
        env["PROJECT_INVITATION_SWEEP_DRY_RUN"] = "1"

    script_path = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(__file__))), "scripts", "project-invitation-sweep.ts")
    cmd = ["node", "--import", "tsx", script_path]
    mode_label = "dry run" if args.dry_run else "live run"
    print(f"Running invitation sweep ({mode_label}) via {script_path}", file=sys.stderr)
    try:
        completed = subprocess.run(cmd, env=env, check=False)
    except FileNotFoundError:
        print("Error: node is required to run invitation-sweep", file=sys.stderr)
        sys.exit(1)

    if completed.returncode != 0:
        print(f"Error: invitation sweep exited with status {completed.returncode}", file=sys.stderr)
        sys.exit(completed.returncode)

    print("✅ Invitation sweep finished.")


