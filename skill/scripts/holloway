def cmd_tasks(args):
    """List tasks for a project."""
    params = []
    if args.sprint:
        params.append(f"sprint_id={args.sprint}")
    if args.status:
        params.append(f"status={normalize_task_status(args.status)}")
    if args.assignee:
        params.append(f"assignee_agent_id={resolve_agent_id(args.assignee)}")
    if args.label:
        params.append(f"label={args.label}")
    query = f"?{'&'.join(params)}" if params else ""
    data = api_request("GET", f"/api/v1/projects/{args.project_id}/tasks{query}")
    tasks = data.get("data", data) if isinstance(data, dict) else data
    if isinstance(tasks, dict):
        tasks = [tasks]
    if not tasks:
        print("No tasks found.")
        return
    print(f"Tasks ({len(tasks)}):\n")
    for t in tasks:
        print(format_task(t))
        print()


def cmd_task(args):
    """Get enriched task details."""
    data = api_request("GET", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}")
    print(format_task(data, verbose=True))


def cmd_task_create(args):
    """Create a new task."""
    body = {"title": args.title}
    if args.description:
        body["description"] = args.description
    if args.sprint_id:
        body["sprint_id"] = args.sprint_id
    if args.priority:
        body["priority"] = normalize_task_priority(args.priority)
    if args.assignee:
        body["assignee_agent_id"] = resolve_agent_id(args.assignee)
    if args.labels:
        body["labels"] = args.labels
    if args.due_date:
        body["due_date"] = args.due_date
    if args.handoff_to:
        invitees = [part.strip() for part in args.handoff_to.split(",") if part.strip()]
        if invitees:
            handoff = {"invitees": invitees}
            if args.handoff_title:
                handoff["title"] = args.handoff_title
            handoff_description = read_text_argument(args.handoff_description, "handoff description")
            if handoff_description:
                handoff["description"] = handoff_description
            if args.handoff_max_turns is not None:
                handoff["max_turns"] = args.handoff_max_turns
            if args.handoff_expires_hours is not None:
                handoff["expires_in_hours"] = args.handoff_expires_hours
            body["handoff_contract"] = handoff
    if args.escalate_to:
        brokers = [part.strip() for part in args.escalate_to.split(",") if part.strip()]
        if brokers:
            escalation = {"brokers": brokers}
            if args.escalation_reason:
                escalation["escalation_reason"] = args.escalation_reason
            if args.requested_intervention:
                escalation["requested_intervention"] = args.requested_intervention
            if args.escalation_title:
                escalation["title"] = args.escalation_title
            escalation_description = read_text_argument(args.escalation_description, "escalation description")
            if escalation_description:
                escalation["description"] = escalation_description
            if args.escalation_max_turns is not None:
                escalation["max_turns"] = args.escalation_max_turns
            if args.escalation_expires_hours is not None:
                escalation["expires_in_hours"] = args.escalation_expires_hours
            body["escalation_contract"] = escalation
    data = api_request("POST", f"/api/v1/projects/{args.project_id}/tasks", body)
    print("✅ Task created!")
    print(format_task(data, verbose=True))


def cmd_task_update(args):
    """Update a task."""
    body = {}
    if args.title:
        body["title"] = args.title
    if args.description:
        body["description"] = args.description
    if args.status:
        body["status"] = normalize_task_status(args.status)
    if args.assignee:
        body["assignee_agent_id"] = resolve_agent_id(args.assignee)
    if args.sprint_id:
        body["sprint_id"] = args.sprint_id
    if args.priority:
        body["priority"] = normalize_task_priority(args.priority)
    if args.labels:
        body["labels"] = args.labels
    if args.due_date:
        body["due_date"] = args.due_date
    if args.handoff_to:
        invitees = [part.strip() for part in args.handoff_to.split(",") if part.strip()]
        if invitees:
            handoff = {"invitees": invitees}
            if args.handoff_title:
                handoff["title"] = args.handoff_title
            handoff_description = read_text_argument(args.handoff_description, "handoff description")
            if handoff_description:
                handoff["description"] = handoff_description
            if args.handoff_max_turns is not None:
                handoff["max_turns"] = args.handoff_max_turns
            if args.handoff_expires_hours is not None:
                handoff["expires_in_hours"] = args.handoff_expires_hours
            body["handoff_contract"] = handoff
    if args.escalate_to:
        brokers = [part.strip() for part in args.escalate_to.split(",") if part.strip()]
        if brokers:
            escalation = {"brokers": brokers}
            if args.escalation_reason:
                escalation["escalation_reason"] = args.escalation_reason
            if args.requested_intervention:
                escalation["requested_intervention"] = args.requested_intervention
            if args.escalation_title:
                escalation["title"] = args.escalation_title
            escalation_description = read_text_argument(args.escalation_description, "escalation description")
            if escalation_description:
                escalation["description"] = escalation_description
            if args.escalation_max_turns is not None:
                escalation["max_turns"] = args.escalation_max_turns
            if args.escalation_expires_hours is not None:
                escalation["expires_in_hours"] = args.escalation_expires_hours
            body["escalation_contract"] = escalation
    if not body:
        print("Error: provide at least one field to update", file=sys.stderr)
        sys.exit(1)
    data = api_request("PATCH", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}", body)
    print("✅ Task updated!")
    print(format_task(data, verbose=True))


