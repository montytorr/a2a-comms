    # dep-add
    p = sub.add_parser("dep-add", help="Add task dependency")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--type", choices=["blocks", "relates_to", "sequence_after"], help="Explicit dependency type override for directional forms")
    p.add_argument("--blocks", help="Current task blocks this task ID")
    p.add_argument("--blocked-by", dest="blocked_by", help="Current task is blocked by this task ID")
    p.add_argument("--relates-to", dest="relates_to", help="Current task relates to this task ID")
    p.add_argument("--sequence-after", dest="sequence_after", help="Current task should happen after this task ID")

    # dep-remove
    p = sub.add_parser("dep-remove", help="Remove task dependency")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--type", choices=["blocks", "relates_to", "sequence_after"], help="Explicit dependency type override for directional forms")
    p.add_argument("--blocks", help="Current task blocks this task ID")
    p.add_argument("--blocked-by", dest="blocked_by", help="Current task is blocked by this task ID")
    p.add_argument("--relates-to", dest="relates_to", help="Current task relates to this task ID")
    p.add_argument("--sequence-after", dest="sequence_after", help="Current task should happen after this task ID")

    # ── Task-Contract Links ───────────────────────────────

    # task-contracts
    p = sub.add_parser("task-contracts", help="List contracts linked to a task")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")

    # contract-link / contract-unlink (contract-side aliases)
    p = sub.add_parser("contract-link", help="Link this contract to a project task")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--project", required=True, help="Project ID")
    p.add_argument("--task", required=True, help="Task ID")

    p = sub.add_parser("contract-unlink", help="Unlink this contract from a project task")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--project", required=True, help="Project ID")
    p.add_argument("--task", required=True, help="Task ID")

    # contract-relate / contract-unrelate / contract-relations (contract <-> contract)
    # Distinct from contract-link, which attaches a contract to a project TASK.
    p = sub.add_parser(
        "contract-relations",
        help="Show contracts this one continues, supersedes, or delegated to",
    )
    p.add_argument("id", help="Contract ID")

    p = sub.add_parser(
        "contract-relate",
        help="Record that this contract continues/supersedes/delegates to another contract",
    )
    p.add_argument("id", help="Contract ID this link starts from")
    p.add_argument("--to", required=True, help="The other contract's ID")
    p.add_argument(
        "--type",
        required=True,
        choices=["continues", "supersedes", "delegates_to"],
        help=(
            "continues: this one carries on work the other left unfinished. "
            "supersedes: this one replaces the other. "
            "delegates_to: this one handed execution onward to the other"
        ),
    )
    p.add_argument("--note", help="One line on why, 500 characters max")

    p = sub.add_parser("contract-unrelate", help="Remove a contract-to-contract link")
    p.add_argument("id", help="Contract ID the link starts from")
    p.add_argument("--to", required=True, help="The other contract's ID")
    p.add_argument("--type", required=True, choices=["continues", "supersedes", "delegates_to"], help="Which link to remove")

    # task-link
    p = sub.add_parser("task-link", help="Link a contract to a task")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--contract", required=True, help="Contract ID to link")

    # task-unlink
    p = sub.add_parser("task-unlink", help="Unlink a contract from a task")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--contract", required=True, help="Contract ID to unlink")

    # Task comments
    p = sub.add_parser("comments", help="List comments/activity for a task")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--page", type=int, default=1, help="Page number")
    p.add_argument("--per-page", type=int, default=20, help="Comments per page")

    p = sub.add_parser("comment", help="Add a comment to a task")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--content", help="Comment content (markdown). Use '-' or omit and pipe via stdin.")
    p.add_argument("--type", choices=["comment", "status_change", "assignment", "system"], default=None, help="Comment type")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    commands = {
        "health": cmd_health,
        "status": cmd_status,
        "agents": cmd_agents,
        "agent": cmd_agent,
        "contracts": cmd_contracts,
        "contract": cmd_contract,
        "contract-describe": cmd_contract_describe,
