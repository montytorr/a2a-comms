# ── Dependency Commands ───────────────────────────────────

def _resolve_dependency_target(args):
    selected = [("blocks", args.blocks), ("blocked-by", getattr(args, 'blocked_by', None)), ("relates_to", getattr(args, 'relates_to', None)), ("sequence_after", getattr(args, 'sequence_after', None))]
    chosen = [(kind, value) for kind, value in selected if value]
    if len(chosen) != 1:
        print("Error: choose exactly one dependency target flag", file=sys.stderr)
        sys.exit(1)
    kind, value = chosen[0]
    if kind == 'blocks':
        return {"blocked_task_id": value, "dependency_type": getattr(args, 'type', None) or 'blocks'}, value, 'blocks'
    if kind == 'blocked-by':
        return {"blocking_task_id": value, "dependency_type": getattr(args, 'type', None) or 'blocks'}, value, 'blocked-by'
    if kind == 'relates_to':
        return {"blocked_task_id": value, "dependency_type": 'relates_to'}, value, 'relates_to'
    return {"blocking_task_id": value, "dependency_type": 'sequence_after'}, value, 'sequence_after'


def cmd_deps(args):
    """List dependencies for a task."""
    data = api_request("GET", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/dependencies")
    sections = [
        ("Blocked by", _get_list_payload(data, "blocked_by"), "blocking_task"),
        ("Blocks", _get_list_payload(data, "blocks"), "blocked_task"),
        ("Sequence after", _get_list_payload(data, "sequence_after"), "blocking_task"),
        ("Sequence before", _get_list_payload(data, "sequence_before"), "blocked_task"),
        ("Related tasks", _get_list_payload(data, "relates_to"), "blocking_task"),
    ]
    total = sum(len(items) for _, items, _ in sections)
    if not total:
        print("No dependencies found.")
        return
    print(f"Dependencies ({total}):\n")
    for title, items, joined_key in sections:
        if not items:
            continue
        print(f"{title}:")
        for d in items:
            joined = d.get(joined_key) or d.get('blocked_task') or d.get('blocking_task') or {}
            if isinstance(joined, list):
                joined = joined[0] if joined else {}
            print(f"  • {joined.get('title', '?')} ({joined.get('id', '?')}) — {d.get('dependency_type', 'blocks')}")
        print()


def cmd_dep_add(args):
    """Add a dependency to a task."""
    body, target, rel = _resolve_dependency_target(args)
    api_request("POST", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/dependencies", body)
    print(f"✅ Dependency added: {args.task_id} -> {target} ({body['dependency_type'] if rel in ['blocks', 'blocked-by'] else rel})")


def cmd_dep_remove(args):
    """Remove a dependency from a task."""
    body, target, rel = _resolve_dependency_target(args)
    data = api_request("GET", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/dependencies")
    candidates = []
    for key in ["blocked_by", "blocks", "sequence_after", "sequence_before", "relates_to"]:
        candidates.extend(_get_list_payload(data, key))
    dep_id = None
    for d in candidates:
        if not isinstance(d, dict):
            continue
        if body.get('dependency_type') and d.get('dependency_type') != body.get('dependency_type'):
            continue
        if d.get('id') == target:
            dep_id = d.get('id')
            break
        if d.get('blocking_task_id') == target or d.get('blocked_task_id') == target:
            dep_id = d.get('id')
            break
    if not dep_id:
        print("Error: failed to resolve dependency id from provided task reference", file=sys.stderr)
        sys.exit(1)
    api_request("DELETE", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/dependencies", {"dependency_id": dep_id})
    print(f"✅ Dependency removed: {args.task_id} x {target} ({body.get('dependency_type') or rel})")


# ── Task-Contract Link Commands ───────────────────────────

def cmd_task_contracts(args):
    """List contracts linked to a task."""
    data = api_request("GET", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/contracts")
    contracts = data.get("data", data) if isinstance(data, dict) else data
    if isinstance(contracts, dict):
        contracts = [contracts]
    if not contracts:
        print("No linked contracts.")
        return
    print(f"Linked contracts ({len(contracts)}):\n")
    for c in contracts:
        contract_id = c.get("contract_id", c.get("id", "?"))
        title = c.get("contract", {}).get("title", c.get("title", ""))
        status = c.get("contract", {}).get("status", c.get("status", ""))
        label = f"  📄 {contract_id}"
        if title:
            label += f" — {title}"
        if status:
            label += f" [{status.upper()}]"
        print(label)


def cmd_task_link(args):
    """Link a contract to a task."""
    body = {"contract_id": args.contract}
    api_request("POST", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/contracts", body)
    print(f"✅ Contract {args.contract} linked to task {args.task_id}")


def cmd_contract_link(args):
    """Link this contract to a project task (contract-side alias for task-link)."""
    api_request(
        "POST",
        f"/api/v1/projects/{args.project}/tasks/{args.task}/contracts",
        {"contract_id": args.id},
    )
    print(f"✅ Contract {args.id} linked to task {args.task}")
    print("   It now has a board, execution tracking, and can take attachments.")


def cmd_contract_relations(args):
    """Show the contracts this one succeeds, replaces, or handed execution to."""
    data = api_request("GET", f"/api/v1/contracts/{args.id}/links")
    links = data.get("related_contracts") or []
    if not links:
        print(f"No related contracts for {args.id}")
        print("   contract-relate records succession between contracts; contract-link attaches one to a project task.")
        return
    print(f"Related contracts for {args.id} ({len(links)}):\n")
    for link in links:
        print(f"   {format_related_contract(link)}\n")


def cmd_contract_relate(args):
    """Record that this contract continues, supersedes, or delegates to another."""
    body = {"to_contract_id": args.to, "link_type": args.type}
    if args.note:
        body["note"] = args.note
    data = api_request("POST", f"/api/v1/contracts/{args.id}/links", body)
    print(f"✅ {args.id} {args.type} {args.to}")
    for link in data.get("related_contracts") or []:
        print(f"   {format_related_contract(link)}")


def cmd_contract_unrelate(args):
    """Remove one contract-to-contract link."""
    data = api_request(
        "DELETE",
        f"/api/v1/contracts/{args.id}/links",
        {"to_contract_id": args.to, "link_type": args.type},
    )
    if data.get("removed"):
        print(f"✅ Removed: {args.id} {args.type} {args.to}")
    else:
        # The end state is what was asked for, so this is not an error. But
        # saying "removed" would announce something that did not happen, and a
        # mistyped id would read as success.
        print(f"• Nothing to remove: {args.id} does not {args.type} {args.to}")


def cmd_contract_unlink(args):
    """Unlink this contract from a project task."""
    api_request(
        "DELETE",
        f"/api/v1/projects/{args.project}/tasks/{args.task}/contracts",
        {"contract_id": args.id},
    )
    print(f"✅ Contract {args.id} unlinked from task {args.task}")


def cmd_task_unlink(args):
    """Unlink a contract from a task."""
    api_request(
        "DELETE",
        f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/contracts",
        {"contract_id": args.contract},
    )
    print(f"✅ Contract {args.contract} unlinked from task {args.task_id}")


# ── Task Comment Commands ─────────────────────────────────

def cmd_comments(args):
    """List comments/activity for a task."""
    page = getattr(args, "page", 1) or 1
    per_page = getattr(args, "per_page", 20) or 20
    data = api_request("GET", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/comments?page={page}&per_page={per_page}")
    comments = data.get("comments", [])
    pagination = data.get("pagination", {})

    if not comments:
        print("No comments yet.")
        return

    total = pagination.get("total", len(comments))
    print(f"Comments ({total} total, page {pagination.get('page', 1)}/{pagination.get('total_pages', 1)}):\n")

    type_icons = {"comment": "💬", "status_change": "🔄", "assignment": "👤", "system": "⚙️"}
    for c in reversed(comments):  # Show chronological (oldest first for display)
        icon = type_icons.get(c.get("comment_type", "comment"), "💬")
        author = c.get("author_name") or "Unknown"
        if c.get("author"):
            a = c["author"]
            author = a.get("display_name") or a.get("name") or author
        ts = c.get("created_at", "")[:16].replace("T", " ")
        ctype = c.get("comment_type", "comment")
        prefix = f"  [{ctype}]" if ctype != "comment" else ""
        print(f"{icon} {author} — {ts}{prefix}")
        print(f"   {c.get('content', '')}")
        print()


def cmd_comment(args):
    """Add a comment to a task."""
    content = args.content
    if not content or content == "-":
        content = sys.stdin.read().strip()
    if not content:
        print("Error: provide --content or pipe content via stdin", file=sys.stderr)
        sys.exit(1)
    body = {"content": content}
    if args.type:
        body["comment_type"] = args.type
    data = api_request("POST", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/comments", body)
    print(f"✅ Comment added (id: {data.get('id', 'unknown')})")


# ── Approval Commands ─────────────────────────────────────

def cmd_approvals(args):
    """List approval requests."""
    status = args.status if args.status else "pending"
    data = api_request("GET", f"/api/v1/approvals?status={status}")
    approvals = data.get("data", [])
    if not approvals:
        print(f"No {status} approvals found.")
        return
    print(f"Approvals ({len(approvals)} {status}):\n")
    for a in approvals:
        status_icons = {"pending": "🕐", "approved": "✅", "denied": "❌"}
        icon = status_icons.get(a.get("status", ""), "❓")
        print(f"  {icon} [{a['status'].upper()}] {a.get('action', '?')}")
        print(f"     ID: {a['id']}")
        print(f"     Actor: {a.get('actor', '?')}")
        if a.get("reviewed_by"):
            print(f"     Reviewed by: {a['reviewed_by']} at {a.get('reviewed_at', '?')}")
        details = a.get("details", {})
        if details:
            print(f"     Details: {json.dumps(details, indent=2)}")
        print(f"     Created: {a.get('created_at', '?')}")
        print()


def cmd_approve(args):
    """Approve a pending request."""
    data = api_request("POST", f"/api/v1/approvals/{args.id}/approve")
    print(f"✅ Approval request approved!")
    print(f"  ID: {data.get('id', args.id)}")
    print(f"  Action: {data.get('action', '?')}")
    print(f"  Actor: {data.get('actor', '?')}")
    print(f"  Reviewed by: {data.get('reviewed_by', '?')}")


def cmd_deny(args):
    """Deny a pending request."""
    data = api_request("POST", f"/api/v1/approvals/{args.id}/deny")
    print(f"❌ Approval request denied!")
    print(f"  ID: {data.get('id', args.id)}")
    print(f"  Action: {data.get('action', '?')}")
    print(f"  Actor: {data.get('actor', '?')}")
    print(f"  Reviewed by: {data.get('reviewed_by', '?')}")


def cmd_request_approval(args):
    """Request approval for an action."""
    details = {}
    if args.details:
        try:
            details = json.loads(args.details)
        except json.JSONDecodeError:
            details = {"text": args.details}

    body = {"action": args.action, "details": details}
    data = api_request("POST", "/api/v1/approvals", body)
    print(f"🛡️ Approval requested!")
    print(f"  ID: {data.get('id', '?')}")
    print(f"  Action: {data.get('action', '?')}")
    print(f"  Status: {data.get('status', '?')}")


# ── Existing Commands (continued) ─────────────────────────

def cmd_pending(_args):
    """List pending contract invitations."""
    data = api_request("GET", "/api/v1/contracts?status=proposed&role=invitee")
    contracts = data.get("data", [])
    if not contracts:
        print("No pending invitations.")
        return
    print(f"Pending invitations ({len(contracts)}):\n")
    print("   (invitations only — `holloway inbox` also lists active contracts awaiting your move)\n")
    for c in contracts:
        print(format_contract(c, verbose=True))
        print()


def cmd_inbox(args):
    """Everything waiting on you: active contracts you owe a move, then invitations."""
    # The active half used to be missing entirely. `pending` and `inbox` both
    # asked only for status=proposed, so a contract where a peer had asked you a
    # question appeared on no list anywhere.
    owed = api_request("GET", "/api/v1/contracts?status=active&awaiting=me").get("data", [])
    # Kept out of "your move" deliberately: an agent has already said it cannot
    # proceed and asked a person, so nobody owes a turn until that is answered.
    blocked = api_request("GET", "/api/v1/contracts?status=active&awaiting=human").get("data", [])
    data = api_request("GET", "/api/v1/contracts?status=proposed&role=invitee")
    contracts = data.get("data", [])

    print("Inbox\n")
    print(f"Your move ({len(owed)}):")
    if owed:
        print()
        for c in owed:
            print(format_contract(c, verbose=True))
            print()
    else:
        print("  Nothing is waiting on you.\n")

    print(f"Waiting on a person ({len(blocked)}):")
    if blocked:
        print("  You owe no move on these — a human has been asked and nothing proceeds")
        print("  until they answer. `holloway questions <contract_id>` shows what was asked.\n")
        for c in blocked:
            print(format_contract(c, verbose=True))
            print()
    else:
        print("  Nothing is waiting on a person.\n")

    print(f"Contract invitations: {len(contracts)}")
    if contracts:
        print()
        for c in contracts:
            print(format_contract(c, verbose=True))
            print()

    if not args.project_id:
        return

    project_data = api_request("GET", f"/api/v1/projects/{args.project_id}/invitations")
    invitations = project_data.get("data", project_data) if isinstance(project_data, dict) else project_data
    if isinstance(invitations, dict):
        invitations = [invitations]

    print(f"Project invitations for {args.project_id}: {len(invitations)}")
    if invitations:
        for inv in invitations:
            agent = inv.get("agent", {})
            inviter = inv.get("invited_by", {})
            name = agent.get("display_name", agent.get("name", inv.get("agent_id", "?")))
            invited_by = inviter.get("display_name", inviter.get("name", inv.get("invited_by_agent_id", "?")))
            status = inv.get("status", "pending").upper()
            expires_at = inv.get("expires_at")
            reminder_sent = inv.get("reminder_sent_at")
            extras = []
            if expires_at and inv.get("status") == "pending":
                extras.append(f"expires: {expires_at}")
            if reminder_sent:
                extras.append(f"reminder: {reminder_sent}")
            suffix = f" | {' | '.join(extras)}" if extras else ""
            print(f"  [{status}] {name} — invited by {invited_by} (id: {inv.get('id')}){suffix}")


def main():
    parser = argparse.ArgumentParser(
        description="Holloway CLI — Agent-to-Agent Contract Communication",
        prog="holloway",
    )
    sub = parser.add_subparsers(dest="command", help="Command")

    # health
    sub.add_parser("health", help="Check API health")

    # status
    sub.add_parser("status", help="Check system status")

    # agents
    sub.add_parser("agents", help="List agents")

    # agent
    p = sub.add_parser("agent", help="Get agent details")
    p.add_argument("id", help="Agent ID or name")

    # contracts
    p = sub.add_parser("contracts", help="List contracts")
    p.add_argument("--status", help="Filter by status")
    p.add_argument("--role", help="Filter by role (proposer|invitee)")
    p.add_argument(
        "--awaiting",
        choices=["me", "peer", "nobody", "human"],
        help=(
            "Only contracts whose next move is yours, the peer's, nobody's, or "
            "a human's (human: an agent asked a person and nothing moves until answered)"
        ),
    )
    p.add_argument("--page", type=int, help="Page number")

    # contract
    p = sub.add_parser("contract", help="Get contract details")
    p.add_argument("id", help="Contract ID")

    # contract-describe
    p = sub.add_parser("contract-describe", help="Rewrite a contract description (proposer only)")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--description", required=True, help="Replacement Markdown; @file.md reads a file, - reads stdin")

    # propose
    p = sub.add_parser("propose", help="Propose a new contract")
    p.add_argument("title", help="Contract title")
    p.add_argument("--to", nargs="+", required=True, help="Agent names to invite")
    p.add_argument("--description", help="Contract description as Markdown; @file.md reads a file, - reads stdin. Over 600 characters it must contain real line breaks")
    p.add_argument("--max-turns", type=int, help="Max turns (default: 50)")
    p.add_argument("--require-completion-approval", action="store_true", help="Prevent close/max-turn completion until the proposer records approval")
    p.add_argument("--expires-hours", type=int, help="Expiry in hours (default: 168)")
    p.add_argument("--schema", help="Message schema (inline JSON or path to JSON file)")
    p.add_argument("--project", help="Link the new contract to this project (use with --task)")
    p.add_argument("--task", help="Link the new contract to this task (use with --project)")

    # accept
    p = sub.add_parser("accept", help="Accept a contract invitation")
    p.add_argument("id", help="Contract ID")

    # reject
    p = sub.add_parser("reject", help="Reject a contract invitation")
    p.add_argument("id", help="Contract ID")

    # cancel
    p = sub.add_parser("cancel", help="Cancel a proposed contract")
    p.add_argument("id", help="Contract ID")

    # close
    p = sub.add_parser("close", help="Close an active contract")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--reason", help="Close reason")

    # messages
    p = sub.add_parser("messages", help="Get message history")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--page", type=int, help="Page number")
    p.add_argument("--per-page", type=int, help="Messages per page")

    # message
    p = sub.add_parser("message", help="Get a specific message")
    p.add_argument("contract_id", help="Contract ID")
    p.add_argument("message_id", help="Message ID")

    # send
    p = sub.add_parser("send", help="Send a message; use Markdown for substantive updates")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--content", required=True, help="Message content. Use structured Markdown for substantive updates; reserve plain text for one-line receipts")
    p.add_argument("--type", choices=["message", "request", "response", "update", "status", "receipt", "approval"], help="Message type")
    p.add_argument("--no-action-required", dest="requires_action", action="store_false", default=None, help="Mark a non-request message as informational so reactors need not spawn a worker")

    p = sub.add_parser("receipt", help="Acknowledge an exact message without consuming a turn")
    p.add_argument("id", help="Contract ID")
    p.add_argument("message_id", help="Message ID being acknowledged")
    p.add_argument("--note", help="Optional human-readable receipt note")

    p = sub.add_parser("approve-completion", help="Record proposer approval for gated contract completion without consuming a turn")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--note", help="Optional approval note")

    # ── Operator channel ──────────────────────────────────

    # notes
    p = sub.add_parser("notes", help="Read the standing notes humans left on a contract")
    p.add_argument("id", help="Contract ID")

    # note-ack
    p = sub.add_parser("note-ack", help="Acknowledge operator notes (all live ones, or the named ones)")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--note", dest="note_ids", action="append", help="Note UUID to acknowledge (repeatable; default: every live note)")

    # ask
    p = sub.add_parser("ask", help="Ask a human a question on this contract (costs no turn)")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--body", required=True, help="The question as Markdown; @file.md reads a file, - reads stdin")
    p.add_argument(
        "--kind",
        choices=QUESTION_KINDS,
        default="question",
        help=(
            "question: you would like an answer but can carry on without one. "
            "validation: you want a person to confirm something before it counts as done. "
            "blocked: you cannot proceed at all until a person responds"
        ),
    )
    p.add_argument("--blocking", dest="blocking", action="store_true", default=None, help="You cannot proceed until this is answered (server default: true for --kind blocked)")
    p.add_argument("--no-blocking", dest="blocking", action="store_false", default=None, help="You can carry on without an answer (server default: true for --kind blocked, false otherwise)")

    # questions
    p = sub.add_parser("questions", help="List questions agents have put to a person on this contract")
    p.add_argument("id", help="Contract ID")
    p.add_argument("--status", choices=QUESTION_STATUSES + ["all"], default="open", help="Which questions to show (default: open)")

    # pending
    sub.add_parser("pending", help="List pending invitations")

    # inbox
    p = sub.add_parser("inbox", help="What is waiting on YOU, then contract and project invitations")
    p.add_argument("--project", dest="project_id", help="Optional project id to include project invitations")

    # webhook
    p = sub.add_parser("webhook", help="Manage webhook push notifications")
    p.add_argument("webhook_action", choices=["get", "set", "remove"], help="get/set/remove")
    p.add_argument("--url", help="Webhook URL")
    p.add_argument("--secret", help="Webhook signing secret (for set)")
    p.add_argument("--events", nargs="+", help="Event types: invitation message contract.* task.* sprint.* project.member_invited project.member_accepted project.member_declined project.member_cancelled project.member_expired approval.* (legacy alias: contract_state)")

    # rotate-keys
    sub.add_parser("rotate-keys", help="Rotate service keys for current agent")

    # ── Approvals ─────────────────────────────────────────

    # approvals
    p = sub.add_parser("approvals", help="List approval requests")
    p.add_argument("--status", default="pending", help="Filter by status (pending|approved|denied|all)")

    # approve
    p = sub.add_parser("approve", help="Approve a pending request")
    p.add_argument("id", help="Approval request ID")

    # deny
    p = sub.add_parser("deny", help="Deny a pending request")
    p.add_argument("id", help="Approval request ID")

    # request-approval
    p = sub.add_parser("request-approval", help="Request approval for an action")
    p.add_argument("--action", required=True, help="Action requiring approval")
    p.add_argument("--details", help="Details (JSON string or plain text)")

    # ── Project Management ────────────────────────────────

    # projects
    p = sub.add_parser("projects", help="List projects")
    p.add_argument("--status", help="Filter by status (planning, active, completed, archived)")
    # GET /api/v1/projects caps at per_page=20, so without this the 21st project
    # was unreachable from the CLI. docs/cli.md and SKILL.md have documented
    # `--page` all along; the flag was simply never added.
    p.add_argument("--page", type=int, help="Page number")

    # project
    p = sub.add_parser("project", help="Get project details")
    p.add_argument("id", help="Project ID")

    # project-create
    p = sub.add_parser("project-create", help="Create a new project")
    p.add_argument("title", help="Project title")
    p.add_argument("--description", help="Project description")
    p.add_argument("--members", nargs="+", help="Agent names or UUIDs to add as members")

    # project-update
    p = sub.add_parser("project-update", help="Update a project")
    p.add_argument("id", help="Project ID")
    p.add_argument("--title", help="New title")
    p.add_argument("--description", help="New description")
    p.add_argument("--status", help="New status")

    # project-members
    p = sub.add_parser("project-members", help="List project members")
    p.add_argument("id", help="Project ID")

    # project-invitations
    p = sub.add_parser("project-invitations", help="List project invitations")
    p.add_argument("id", help="Project ID")

    # project-observers
    p = sub.add_parser("project-observers", help="List project observers")
    p.add_argument("id", help="Project ID")

    # project-observer-add
    p = sub.add_parser("project-observer-add", help="Add a read-only observer to a project")
    p.add_argument("id", help="Project ID")
    p.add_argument("--agent", required=True, help="Agent name or UUID to add as observer")
    p.add_argument("--note", help="Why this agent is observing")

    # project-observer-update
    p = sub.add_parser("project-observer-update", help="Change an observer's note")
    p.add_argument("id", help="Project ID")
    p.add_argument("observer_id", help="Observer ID")
    p.add_argument("--note", help="New note (omit to clear)")

    # project-observer-remove
    p = sub.add_parser("project-observer-remove", help="Remove an observer from a project")
    p.add_argument("id", help="Project ID")
    p.add_argument("observer_id", help="Observer ID")

    # project-invite
    p = sub.add_parser("project-invite", help="Invite member to project")
    p.add_argument("id", help="Project ID")
    p.add_argument("--agent", required=True, help="Agent name or UUID to invite")

    # project-invitation-accept
    p = sub.add_parser("project-invitation-accept", help="Accept project invitation")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("invitation_id", help="Invitation ID")

    # project-invitation-decline
    p = sub.add_parser("project-invitation-decline", help="Decline project invitation")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("invitation_id", help="Invitation ID")

    # project-invitation-cancel
    p = sub.add_parser("project-invitation-cancel", help="Cancel project invitation")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("invitation_id", help="Invitation ID")

    # invitation-sweep
    p = sub.add_parser("invitation-sweep", help="Run the project invitation reminder/expiry sweep once")
    p.add_argument("--dry-run", action="store_true", help="Report pending reminder/expiry actions without mutating state")

    # ── Sprints ───────────────────────────────────────────

    # sprints
    p = sub.add_parser("sprints", help="List sprints for a project")
    p.add_argument("project_id", help="Project ID")

    # sprint
    p = sub.add_parser("sprint", help="Get sprint details")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("sprint_id", help="Sprint ID")

    # sprint-create
    p = sub.add_parser("sprint-create", help="Create a new sprint")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("title", help="Sprint title")
    p.add_argument("--goal", help="Sprint goal")
    p.add_argument("--start-date", help="Start date (YYYY-MM-DD)")
    p.add_argument("--end-date", help="End date (YYYY-MM-DD)")

    # sprint-update
    p = sub.add_parser("sprint-update", help="Update a sprint")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("sprint_id", help="Sprint ID")
    p.add_argument("--title", help="New title")
    p.add_argument("--status", help="New status (planning, active, completed, cancelled)")

    # ── Tasks ─────────────────────────────────────────────

    # tasks
    p = sub.add_parser("tasks", help="List tasks for a project")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("--sprint", help="Filter by sprint ID")
    p.add_argument(
        "--status",
        choices=["backlog", "todo", "in-progress", "in_review", "in-review", "done", "cancelled"],
        help="Filter by status (backlog, todo, in-progress, in-review, done, cancelled)",
    )
    p.add_argument("--assignee", help="Filter by assignee agent name or UUID")
    p.add_argument("--label", help="Filter by label")

    # task
    p = sub.add_parser("task", help="Get enriched task details")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")

    # task-create
    p = sub.add_parser("task-create", help="Create a new task")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("title", help="Task title")
    p.add_argument("--description", help="Task description")
    p.add_argument("--sprint-id", help="Sprint ID to assign to")
    p.add_argument("--priority", choices=["critical", "urgent", "high", "medium", "low"], help="Task priority (critical is legacy alias for urgent)")
    p.add_argument("--assignee", help="Assignee agent name or UUID")
    p.add_argument("--labels", nargs="+", help="Task labels")
    p.add_argument("--due-date", help="Due date (YYYY-MM-DD)")
    p.add_argument("--handoff-to", help="Comma-separated agent names/IDs to invite for delegated handoff")
    p.add_argument("--handoff-title", help="Override generated handoff contract title")
    p.add_argument("--handoff-description", help="Override the generated handoff contract description; @file.md reads a file, - reads stdin")
    p.add_argument("--handoff-max-turns", type=int, help="Override generated handoff contract max turns")
    p.add_argument("--handoff-expires-hours", type=int, help="Override generated handoff contract expiration (hours)")
    p.add_argument("--escalate-to", help="Comma-separated broker agent names/IDs for escalation")
    p.add_argument("--escalation-reason", help="Why escalation is needed")
    p.add_argument("--requested-intervention", help="What intervention is requested from the broker")
    p.add_argument("--escalation-title", help="Override generated escalation contract title")
    p.add_argument("--escalation-description", help="Override the generated escalation contract description; @file.md reads a file, - reads stdin")
    p.add_argument("--escalation-max-turns", type=int, help="Override generated escalation contract max turns")
    p.add_argument("--escalation-expires-hours", type=int, help="Override generated escalation contract expiration (hours)")

    # task-update
    p = sub.add_parser("task-update", help="Update a task")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--title", help="New title")
    p.add_argument("--description", help="New description")
    p.add_argument(
        "--status",
        choices=["backlog", "todo", "in-progress", "in_review", "in-review", "done", "cancelled"],
        help="New status",
    )
    p.add_argument("--assignee", help="New assignee agent name or UUID")
    p.add_argument("--sprint-id", help="New sprint ID")
    p.add_argument("--priority", choices=["critical", "urgent", "high", "medium", "low"], help="New priority (critical is legacy alias for urgent)")
    p.add_argument("--labels", nargs="+", help="New labels")
    p.add_argument("--due-date", help="New due date (YYYY-MM-DD)")
    p.add_argument("--handoff-to", help="Comma-separated agent names/IDs to invite for delegated handoff")
    p.add_argument("--handoff-title", help="Override generated handoff contract title")
    p.add_argument("--handoff-description", help="Override the generated handoff contract description; @file.md reads a file, - reads stdin")
    p.add_argument("--handoff-max-turns", type=int, help="Override generated handoff contract max turns")
    p.add_argument("--handoff-expires-hours", type=int, help="Override generated handoff contract expiration (hours)")
    p.add_argument("--escalate-to", help="Comma-separated broker agent names/IDs for escalation")
    p.add_argument("--escalation-reason", help="Why escalation is needed")
    p.add_argument("--requested-intervention", help="What intervention is requested from the broker")
    p.add_argument("--escalation-title", help="Override generated escalation contract title")
    p.add_argument("--escalation-description", help="Override the generated escalation contract description; @file.md reads a file, - reads stdin")
    p.add_argument("--escalation-max-turns", type=int, help="Override generated escalation contract max turns")
    p.add_argument("--escalation-expires-hours", type=int, help="Override generated escalation contract expiration (hours)")

    # blocker-follow-up
    p = sub.add_parser("blocker-follow-up", help="Log blocker follow-up workflow details")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--next-action", required=True, help="Concrete unblock step to record")
    p.add_argument("--owner", required=True, help="Who owns the unblock step")
    p.add_argument("--due-at", required=True, help="Expected follow-up time (ISO 8601)")

    # blocker-escalate
    p = sub.add_parser("blocker-escalate", help="Escalate blocker workflow details")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--next-action", required=True, help="Concrete escalation or unblock step to record")
    p.add_argument("--owner", required=True, help="Who owns the escalation or unblock step")
    p.add_argument("--due-at", required=True, help="Expected follow-up time (ISO 8601)")

    # task-runs
    p = sub.add_parser("task-runs", help="List execution runs for a task")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")

    # task-run-start
    p = sub.add_parser("task-run-start", help="Start a new execution run for a task")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--status", choices=sorted(RUN_STATUSES), help="Initial execution run status")
    p.add_argument("--summary", help="Run summary")
    p.add_argument("--metadata", help="JSON object metadata")

    # task-run
    p = sub.add_parser("task-run", help="Get a specific execution run")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("run_id", help="Execution run ID")

    # task-run-update
    p = sub.add_parser("task-run-update", help="Update/heartbeat/complete/fail/cancel an execution run")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("run_id", help="Execution run ID")
    p.add_argument("--status", choices=sorted(RUN_STATUSES), help="New execution run status")
    p.add_argument("--summary", help="Run summary")
    p.add_argument("--error-message", help="Failure/cancellation detail")
    p.add_argument("--metadata", help="JSON object metadata")
    p.add_argument("--heartbeat", action="store_true", help="Stamp a heartbeat without changing status")

    # checkpoints
    p = sub.add_parser("checkpoints", help="List checkpoints for an execution run")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("run_id", help="Execution run ID")

    # checkpoint
    p = sub.add_parser("checkpoint", help="Append a checkpoint to an execution run")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("run_id", help="Execution run ID")
    p.add_argument("--key", required=True, help="Checkpoint key")
    p.add_argument("--summary", help="Checkpoint summary")
    p.add_argument("--payload", help="JSON object payload")
    p.add_argument("--attachment-id", dest="attachment_ids", action="append", help="Attach uploaded artifact ID (repeatable)")

    # task-attach
    p = sub.add_parser("task-attach", help="Upload a task artifact via multipart form-data")
    p.add_argument("project_id", help="Project ID")
    p.add_argument("task_id", help="Task ID")
    p.add_argument("--file", required=True, help="File path to upload")
    p.add_argument("--note", help="Optional attachment note")
    p.add_argument("--run-id", help="Optional run ID association")
    p.add_argument("--checkpoint-id", help="Optional checkpoint ID to append attachment onto")

    # contract-attach
    p = sub.add_parser("contract-attach", help="Upload a contract artifact via multipart form-data")
    p.add_argument("contract_id", help="Contract ID")
    p.add_argument("--file", required=True, help="File path to upload")
    p.add_argument("--note", help="Optional attachment note")

    # ── Dependencies ──────────────────────────────────────

