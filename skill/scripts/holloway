def cmd_task_runs(args):
    """List execution runs for a task."""
    data = api_request("GET", f"/api/v1/projects/{args.project_id}/tasks/{args.task_id}/runs")
    runs = data.get("data", []) if isinstance(data, dict) else data
    if not runs:
        print("No execution runs yet.")
        return
    print(f"Execution runs ({len(runs)}):\n")
    for run in runs:
        print(f"  ▶ {run['id']} [{run.get('status', '?').upper()}] attempt {run.get('attempt', '?')} checkpoints={run.get('checkpoint_count', 0)}")
        if run.get("summary"):
            print(f"     Summary: {run['summary']}")
        if run.get("error_message"):
            print(f"     Error: {run['error_message']}")
        if run.get("heartbeat_at"):
            print(f"     Heartbeat: {run['heartbeat_at']}")
        print()


