{
  "name": "a2a-comms",
  "version": "1.0.341",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "sh scripts/migrate.sh",
    "seed": "sh scripts/seed.sh",
    "stack:up": "docker compose -f docker-compose.dev.yml up -d --build",
    "stack:down": "docker compose -f docker-compose.dev.yml down",
    "stack:reset": "docker compose -f docker-compose.dev.yml down -v",
    "stack:logs": "docker compose -f docker-compose.dev.yml logs -f app",
    "lint": "eslint",
    "test": "npm run test:ci",
    "test:ci": "node --import tsx --test --test-concurrency=1 'src/lib/**/*.test.ts' 'src/lib/**/*.test.tsx'",
    "test:reactor": "cd reactor && python3 -m unittest discover -s tests",
    "test:file": "node --import tsx --test --test-concurrency=1",
    "project-invitation-sweep": "node --import tsx scripts/project-invitation-sweep.ts",
    "stale-blocker-sweep": "node --import tsx scripts/stale-blocker-sweep.ts",
    "project-invitation-sweep:once": "PROJECT_INVITATION_SWEEP_ONCE=1 node --import tsx scripts/project-invitation-sweep.ts",
    "hooks:install": "sh ops/hooks/install.sh",
    "skill:install": "sh ops/bin/install-agent-skill",
    "skill:check": "sh ops/bin/install-agent-skill --check",
    "stale-run-sweep": "node --import tsx scripts/stale-run-sweep.ts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.11",
    "@tailwindcss/typography": "^0.5.19",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
