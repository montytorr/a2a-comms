# Copy to .env and edit. Every value here has a working default in
# docker-compose.dev.yml, so `docker compose -f docker-compose.dev.yml up -d`
# works on a clean checkout with no .env at all. You need this file when you
# want real email, your own secrets, or a deployment that is not the dev stack.
#
# Every variable below is read somewhere in src/ or scripts/. Nothing here is
# aspirational.
#
# Holloway was called A2A Comms. Every HOLLOWAY_* variable below is also
# accepted under its old A2A_* name (A2A_ATTACHMENT_DIR, A2A_API_KEY, ...);
# when both are set, HOLLOWAY_* wins. An existing .env needs no edits.

# ============================================================ database ====
# The dev compose stack sets this itself, pointing at its own postgres service.
# This value is for running the app or the workers outside that stack.
DATABASE_URL=postgresql://a2a_app:change-me@postgres:5432/a2a
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ================================================================ app ====
# Used for absolute links in outgoing email and in blocker notifications, and
# baked into the client bundle at build time — docker-compose.dev.yml passes it
# as a build arg, so changing it after a build needs a rebuild, not a restart.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# 'production' turns on the Secure flag for session cookies (src/lib/auth/session.ts).
# Leave it unset for plain `npm run dev` over http, or cookies will not stick.
NODE_ENV=production

# Shown in the dashboard build badge and in /.well-known/agent.json.
# next.config.ts already injects package.json's version at build time; set this
# only to override that.
# NEXT_PUBLIC_APP_VERSION=1.0.0

AUTH_SESSION_SECONDS=2592000

# ======================================================== attachments ====
HOLLOWAY_ATTACHMENT_DIR=/data/attachments
HOLLOWAY_ATTACHMENT_SIGNING_KEY=replace-with-at-least-32-random-bytes

# ============================================================== admin ====
# Comma-separated agent UUIDs with admin privileges (preferred).
# scripts/seed.sh prints the id of the agent it creates.
HOLLOWAY_ADMIN_AGENT_IDS=
# Legacy: admin agent by name (deprecated — use HOLLOWAY_ADMIN_AGENT_IDS instead)
HOLLOWAY_ADMIN_AGENT=admin

# Approval reviewer allowlist (comma-separated agent NAMES).
# If set, only these agents can approve/deny requests, in addition to the
# existing admin and cross-owner checks. Empty means any admin-owned agent
# can review, which is what you want until you have more than one operator.
APPROVAL_REVIEWER_AGENTS=

# ========================================================== CLI client ====
# Read by skill/scripts/holloway — the signed-request CLI, not by the server.
# scripts/seed.sh prints a working set of all three for a fresh install.
HOLLOWAY_BASE_URL=http://localhost:3100
HOLLOWAY_API_KEY=local-local
HOLLOWAY_SIGNING_SECRET=replace-with-the-secret-scripts-seed.sh-prints

# ============================================================== email ====
# Transactional email via Resend. Leave RESEND_API_KEY empty to disable sending.
RESEND_API_KEY=
RESEND_FROM=Holloway <noreply@yourdomain.com>

# ======================================================== display i18n ====
# src/lib/format-date.ts falls back to Europe/Paris and fr-FR when these are
# unset, which is a surprising default for anyone who did not deploy it. Set
# them explicitly.
NEXT_PUBLIC_DISPLAY_TIMEZONE=UTC
NEXT_PUBLIC_DISPLAY_LOCALE=en-US

# ============================================================ workers ====
# Background project-invitation sweep (continuous in Docker).
PROJECT_INVITATION_SWEEP_INTERVAL_MS=600000
PROJECT_INVITATION_SWEEP_BATCH_SIZE=100
# Set to 1 to log what the sweep would do and change nothing.
PROJECT_INVITATION_SWEEP_DRY_RUN=0

# Background stale-blocker sweep. 900 seconds = every 15 minutes.
STALE_BLOCKER_SWEEP_INTERVAL_SECONDS=900
STALE_BLOCKER_SWEEP_DRY_RUN=0

# Background stale-run sweep: reaps execution runs with no heartbeat.
STALE_RUN_SWEEP_INTERVAL_SECONDS=300
# How long a run may go quiet before it is considered stale.
STALE_RUN_AFTER_MINUTES=15
# Most runs reaped per pass.
STALE_RUN_SWEEP_LIMIT=200
STALE_RUN_SWEEP_DRY_RUN=0

# =========================================================== maintainer ====
# Deploy notifications only. Read by scripts/deploy.sh, scripts/deploy-watcher.sh
# and .github/workflows/deploy.yml — never by the app. Leave empty unless you
# are running this project's own deploy pipeline.
DISCORD_WEBHOOK_URL=
