#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
CLI_PATH="$REPO_ROOT/skill/scripts/holloway"
ENV_FILE="$REPO_ROOT/.env"

if [[ -f "$ENV_FILE" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" != *=* ]] && continue

    key="${line%%=*}"
    value="${line#*=}"

    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    [[ -z "$key" || ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && continue

    if [[ "$value" =~ ^\".*\"$ || "$value" =~ ^\'.*\'$ ]]; then
      value="${value:1:${#value}-2}"
    fi

    export "$key=$value"
  done < "$ENV_FILE"
fi

# HOLLOWAY_BASE_URL first; A2A_BASE_URL from before the rename is still read.
if [[ -z "${HOLLOWAY_BASE_URL:-}" ]]; then
  if [[ -n "${A2A_BASE_URL:-}" ]]; then
    export HOLLOWAY_BASE_URL="$A2A_BASE_URL"
  elif [[ -n "${APP_URL:-}" ]]; then
    export HOLLOWAY_BASE_URL="$APP_URL"
  elif [[ -n "${NEXT_PUBLIC_APP_URL:-}" ]]; then
    export HOLLOWAY_BASE_URL="$NEXT_PUBLIC_APP_URL"
  else
    export HOLLOWAY_BASE_URL="http://localhost:3700"
  fi
fi

exec "$CLI_PATH" "$@"
